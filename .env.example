# =============================================================================
# RTA — Association Savings & Loan Management System
# -----------------------------------------------------------------------------
# Copy to `.env` and fill in real values. `.env` is gitignored.
#
# RULE: nothing in this file may ever be prefixed NEXT_PUBLIC_ unless it is
# genuinely safe to print in page source. Payment credentials, database URLs,
# JWT/session secrets and SMS keys are server-only, always.
# =============================================================================

NODE_ENV=development
# Absolute base URL of this deployment. Used for links in emails/SMS and for
# building the payment callback URL registered with the provider.
APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
# Runtime connection. On a hosted provider use the POOLED string — the one
# with "-pooler" in the host (Neon) or port 6543 (Supabase).
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/rta_savings?schema=public

# Migration connection. Must be the DIRECT (non-pooled) string: PgBouncer in
# transaction mode cannot hold the locks Prisma Migrate needs. On a plain local
# Postgres this is the same value as DATABASE_URL and can be left blank.
DIRECT_DATABASE_URL=

# Optional. Prisma Migrate uses a shadow database to detect schema drift; on a
# local Postgres it creates one automatically if this is left blank. Hosted
# providers usually require an explicit empty database here.
SHADOW_DATABASE_URL=

# -----------------------------------------------------------------------------
# AUTH & SESSION SECURITY
# -----------------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating this invalidates every active session — which is the intended
# emergency response to a suspected token leak.
SESSION_SECRET=
# Session lifetime and idle timeout, in minutes.
SESSION_TTL_MINUTES=720
SESSION_IDLE_TIMEOUT_MINUTES=120
# Account lockout policy.
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
# Lifetime of a printed sign-in QR code, in days. The image is a bearer
# credential — anyone who photographs the card can sign in as its owner until
# it expires or the owner regenerates it — so this is an expiry, not a
# formality. Note that rotating SESSION_SECRET also makes every existing QR
# code unreadable, since the stored secret is encrypted under a key derived
# from it; members simply generate a new one.
QR_ACCESS_TTL_DAYS=180

# -----------------------------------------------------------------------------
# JENGA API (Equity Bank / Finserve)
# -----------------------------------------------------------------------------
# Adapter selection. `sandbox` uses the in-repo mock adapter and touches no
# real bank; `live` requires every credential below. Production must be `live`.
JENGA_MODE=sandbox
# Sandbox: https://uat.finserve.africa   Live: https://api.finserve.africa
JENGA_API_BASE_URL=https://uat.finserve.africa
JENGA_API_KEY=
JENGA_MERCHANT_CODE=
JENGA_CONSUMER_SECRET=
# RSA private key used to sign requests. Supply EITHER an absolute path to the
# .pem file (preferred — keeps the key off the environment) OR the key itself
# base64-encoded on a single line.
JENGA_PRIVATE_KEY_PATH=
JENGA_PRIVATE_KEY_BASE64=
# The collection account member payments land in.
JENGA_ACCOUNT_NUMBER=
# ISO alpha-2. RW for Equity Bank Rwanda.
JENGA_COUNTRY_CODE=RW
# Shared secret the provider signs webhook callbacks with. Callbacks failing
# this check are rejected without being processed.
JENGA_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# BANK OF KIGALI OPENAPI
# -----------------------------------------------------------------------------
# Adapter selection. `sandbox` uses the sandbox environment; `live` uses
# production. Production must be `live`.
BK_MODE=sandbox
# Sandbox: https://sandbox.bk.rw   Live: https://api.bk.rw
BK_API_BASE_URL=https://sandbox.bk.rw
# Sent as `apiKey` and `apiSecret` in the JSON body of
# POST /api/bankingAsService/openAPI/identity/authenticate, which is what
# issues the bearer token and session every other BK call needs. Leave both
# blank to disable the BK integration entirely.
BK_CLIENT_ID=
BK_CLIENT_SECRET=
# Not used by the OpenAPI integration. The authenticate endpoint takes only
# apiKey/apiSecret; these remain for older BK endpoints if they are ever needed.
BK_API_USERNAME=
BK_API_PASSWORD=
# The association's Bank of Kigali account number for transaction matching
BK_COLLECTION_ACCOUNT=
# How often to sync BK transactions (cron format)
BK_SYNC_CRON=*/15 * * * *
# How far back to look for transactions (hours)
BK_SYNC_LOOKBACK_HOURS=48

# Near-real-time poll, so money that lands is visible within seconds rather
# than at the next run of the cron sync above. The two are complementary: the
# poll watches a short recent window, the cron sync sweeps a long one and
# repairs anything the poll missed while the worker was restarting.
#
# The poll re-arms only after each tick finishes and backs off when BK is
# failing, so a slow or unreachable bank cannot pile ticks up on top of one
# another. It writes a sync-log row only when it finds or breaks something.
#
# Lowering BK_POLL_SECONDS raises your request rate against BK proportionally:
# at 5s that is ~17,000 authenticated calls a day per association. Check this
# against your BK rate limit before reducing it further.
BK_POLL_ENABLED=true
BK_POLL_SECONDS=5
# How far back each poll looks. Must comfortably exceed BK_POLL_SECONDS so a
# missed tick is picked up by the next one.
BK_POLL_LOOKBACK_MINUTES=15
# Pages per poll. Deep pagination is the cron sync's job, not the poll's.
BK_POLL_MAX_PAGES=2

# -----------------------------------------------------------------------------
# PAYMENT RECONCILIATION POLICY
# -----------------------------------------------------------------------------
# How far back each polling run looks, and how often it runs.
RECONCILIATION_LOOKBACK_HOURS=48
RECONCILIATION_CRON=*/15 * * * *
# Minimum match confidence (0-100) required to auto-credit a member. Anything
# below this is parked in the unmatched queue for an admin to resolve by hand.
# Do not lower this without understanding that it trades accuracy for speed.
PAYMENT_AUTO_MATCH_MIN_CONFIDENCE=90
PAYMENT_MAX_RETRIES=5

# -----------------------------------------------------------------------------
# BANK STATEMENT PDF EXTRACTION
# -----------------------------------------------------------------------------
# Reconstructing a table out of a PDF is done by scripts/pdf_extract.py, which
# uses pdfplumber. Install it once with:
#
#     pip install -r scripts/requirements.txt
#
#   auto   — use Python, fall back to the JavaScript parser if it is missing.
#   python — Python only. A missing interpreter fails the upload loudly.
#            USE THIS IN PRODUCTION: the fallback parser can fuse two adjacent
#            columns into a single wrong amount on tightly-set statements, and
#            downgrading to it silently is exactly what you do not want.
#   node   — JavaScript only, for working without Python installed.
STATEMENT_EXTRACTOR=auto
# Interpreter to invoke. Defaults to `python` on Windows, `python3` elsewhere.
# Set explicitly when using a virtualenv, e.g. /srv/rta/.venv/bin/python
# PYTHON_BIN=python3

# -----------------------------------------------------------------------------
# NOTIFICATIONS
# -----------------------------------------------------------------------------
# Email. `log` writes to the application log instead of sending — the default
# for local development.
#
# DO NOT QUOTE THESE VALUES. dotenv strips surrounding quotes; Docker's
# --env-file does not, and the quotes end up inside the value. Since the app
# runs both ways, unquoted is the only form that reads identically in each.
#
# Gmail: use an App Password, not the account password — ordinary passwords are
# refused. It requires 2-Step Verification on the account, and is shown in four
# spaced groups that must be entered here WITHOUT the spaces. Port 587 is
# STARTTLS, so SMTP_SECURE stays false; only port 465 uses implicit TLS.
#
# Gmail rewrites the From header to the authenticated account, so set
# EMAIL_FROM to that same address or recipients see a mismatch.
#
# Verify with: npx tsx --tsconfig tsconfig.scripts.json scripts/smtp-check.ts
EMAIL_PROVIDER=log
EMAIL_FROM=RTA Savings <no-reply@rta.rw>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# SMS. One of: log | africastalking | twilio
SMS_PROVIDER=log
SMS_SENDER_ID=RTA
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# -----------------------------------------------------------------------------
# FILE STORAGE
# -----------------------------------------------------------------------------
# Uploaded member documents. Served only through an authorised route handler,
# never as static files.
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
STORAGE_MAX_UPLOAD_MB=10

# -----------------------------------------------------------------------------
# BACKGROUND WORKER
# -----------------------------------------------------------------------------
# The worker runs as its own process (`npm run worker`). Set to false on
# replicas so scheduled jobs only ever run on one node.
WORKER_ENABLED=true
LOAN_REMINDER_CRON=0 8 * * *
OVERDUE_CHECK_CRON=0 1 * * *

# -----------------------------------------------------------------------------
# OBSERVABILITY
# -----------------------------------------------------------------------------
LOG_LEVEL=info
