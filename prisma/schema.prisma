// ============================================================================
// RTA — Association Savings & Loan Management System
// ----------------------------------------------------------------------------
// Design rules enforced by this schema:
//
//  1. MONEY IS NEVER A FLOAT. Every monetary column is Decimal(18,2), which
//     Postgres stores as exact NUMERIC. Application code must use
//     Prisma.Decimal for all arithmetic — never JavaScript numbers.
//
//  2. THE LEDGER IS APPEND-ONLY. SavingsTransaction and LoanTransaction rows
//     are never updated or deleted once posted. Corrections happen by posting
//     a REVERSAL/ADJUSTMENT row that points back at the original.
//
//  3. BALANCES ARE DERIVED, NOT TRUSTED. SavingsAccount.balance is a cache
//     that may only be written inside the same database transaction that
//     appends the ledger row, under a row lock. Every ledger row records
//     balanceBefore/balanceAfter and a per-account monotonic `sequence`, so
//     the cache can always be rebuilt and verified against history.
//
//  4. NO PAYMENT IS PROCESSED TWICE. Payment carries unique constraints on
//     the provider's own identifiers, so a replayed webhook or an overlapping
//     reconciliation poll cannot credit a member a second time.
//
//  5. TENANCY IS STRUCTURAL. Every tenant-scoped model carries associationId
//     and indexes it first, so queries are always scoped and cross-tenant
//     reads are impossible when the repository layer applies the filter.
// ============================================================================

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

// Prisma 7 moved the connection URL out of the schema. It now lives in
// `prisma.config.ts` for CLI/migration commands, and is supplied to the
// PrismaClient constructor via the pg driver adapter at runtime
// (see lib/db/prisma.ts). The credential therefore never appears in a file
// that gets committed.
datasource db {
  provider = "postgresql"
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserRole {
  MEMBER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  LOCKED
  DISABLED
}

enum MemberStatus {
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
  INACTIVE
  EXITED
  REJECTED
}

enum KycStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNDISCLOSED
}

enum AssociationStatus {
  PENDING
  ACTIVE
  SUSPENDED
  ARCHIVED
}

/// Ledger movement classification. Mirrors the transaction types required by
/// the business spec; FEE and REVERSAL are added because a real ledger cannot
/// express charges or corrections without them.
enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  LOAN_DISBURSEMENT
  LOAN_REPAYMENT
  PENALTY
  INTEREST
  FEE
  ADJUSTMENT
  REVERSAL
  OTHER
}

/// CREDIT increases the member's savings balance, DEBIT decreases it.
/// Stored explicitly rather than inferred from `type` so that adjustments and
/// reversals can move in either direction without special-casing.
enum TransactionDirection {
  CREDIT
  DEBIT
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

enum PaymentChannel {
  JENGA_EQUITY
  MOBILE_MONEY
  BANK_TRANSFER
  CASH
  CHEQUE
  INTERNAL_TRANSFER
  OTHER
}

/// Lifecycle of an inbound provider payment, from raw capture through to a
/// posted ledger entry. A payment only reaches PROCESSED after it has been
/// verified as successful with the provider AND matched to a member.
enum PaymentStatus {
  RECEIVED
  PENDING
  VERIFIED
  UNMATCHED
  MATCHED
  PROCESSED
  FAILED
  DUPLICATE
  REJECTED
  REVERSED
}

/// How a payment was attributed to a member, in descending order of trust.
/// NAME and AMOUNT are deliberately absent — they are never sufficient.
enum MatchStrategy {
  MEMBER_PAYMENT_REFERENCE
  EXTERNAL_CUSTOMER_REFERENCE
  MOBILE_MONEY_ACCOUNT
  BANK_ACCOUNT
  PHONE_NUMBER
  /// Suggested from the sender's name because no reference was quoted.
  /// Deliberately scored below the auto-credit threshold — it identifies a
  /// candidate for an administrator to confirm, and never credits on its own.
  PAYER_NAME
  MANUAL_ADMIN
  NONE
}

enum ReconciliationOutcome {
  MATCHED
  UNMATCHED
  AMBIGUOUS
  DUPLICATE
  VERIFICATION_FAILED
  PROVIDER_ERROR
  REJECTED
  POSTED
  MANUAL_OVERRIDE
}

enum WithdrawalStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum LoanApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  MORE_INFORMATION_REQUIRED
  APPROVED
  REJECTED
  CANCELLED
}

enum LoanStatus {
  PENDING_DISBURSEMENT
  DISBURSED
  ACTIVE
  COMPLETED
  OVERDUE
  DEFAULTED
  WRITTEN_OFF
  RESTRUCTURED
  CANCELLED
}

enum InstallmentStatus {
  UPCOMING
  DUE
  PARTIALLY_PAID
  PAID
  OVERDUE
  WAIVED
}

enum RepaymentFrequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  CUSTOM
}

enum InterestMethod {
  FLAT
  REDUCING_BALANCE
}

/// Whether a configured fee is a fixed amount or a percentage of principal.
enum ChargeType {
  FIXED
  PERCENTAGE
}

enum LoanTransactionType {
  DISBURSEMENT
  REPAYMENT
  INTEREST_ACCRUAL
  PENALTY
  FEE
  WAIVER
  WRITE_OFF
  ADJUSTMENT
  REVERSAL
}

enum GuarantorStatus {
  PENDING
  ACCEPTED
  DECLINED
  RELEASED
}

/// Lifecycle of money the ASSOCIATION borrowed from a bank or microfinance
/// institution. Deliberately separate from LoanStatus: that one tracks money
/// the association lent OUT to a member, this one tracks money it owes. The
/// two move in opposite directions on the balance sheet and conflating them
/// is how an association reports a liability as an asset.
enum InstitutionalLoanStatus {
  PENDING_DISBURSEMENT
  ACTIVE
  OVERDUE
  COMPLETED
  DEFAULTED
  CANCELLED
  WRITTEN_OFF
}

/// Who lent the association the money. Recorded because members ask it by
/// name — "which bank?" is the first question at every general meeting.
enum LenderType {
  BANK
  MICROFINANCE
  SACCO
  GOVERNMENT_PROGRAMME
  NGO
  COOPERATIVE_UNION
  OTHER
}

/// What the association put money into. A category rather than free text so
/// the member-facing page can group and total it; the specifics live in the
/// record's own title and narrative.
enum InvestmentCategory {
  EQUIPMENT
  WORKSHOP_SPACE
  BULK_MATERIALS
  TRAINING
  MARKET_ACCESS
  PROPERTY
  MEMBER_LENDING
  EMERGENCY_FUND
  OTHER
}

/// Where the money for an investment came from. Members are entitled to know
/// whether their savings or a bank facility paid for something, because the
/// two carry different risk to them.
enum FundingSource {
  MEMBER_SAVINGS
  BANK_LOAN
  RETAINED_SURPLUS
  GRANT
  MIXED
}

enum InvestmentStatus {
  PLANNED
  ACTIVE
  COMPLETED
  PAUSED
  CANCELLED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
  WHATSAPP
}

enum NotificationStatus {
  PENDING
  QUEUED
  SENT
  DELIVERED
  FAILED
  SKIPPED
}

enum NotificationSeverity {
  INFO
  SUCCESS
  WARNING
  CRITICAL
}

enum DocumentType {
  NATIONAL_ID
  PASSPORT
  PHOTO
  PROOF_OF_ADDRESS
  BUSINESS_LICENCE
  LOAN_SUPPORTING_DOCUMENT
  LOAN_AGREEMENT
  GUARANTOR_CONSENT
  COLLATERAL_DOCUMENT
  STATEMENT
  OTHER
}

enum SettingScope {
  PLATFORM
  ASSOCIATION
}

enum SettingValueType {
  STRING
  NUMBER
  DECIMAL
  BOOLEAN
  JSON
  DATE
}

enum JobStatus {
  RUNNING
  SUCCESS
  FAILED
  PARTIAL
  SKIPPED
}

enum AuditSeverity {
  INFO
  NOTICE
  WARNING
  CRITICAL
}

enum TokenPurpose {
  EMAIL_VERIFICATION
  PHONE_VERIFICATION
  PASSWORD_RESET
  INVITATION
  TWO_FACTOR
}

// ============================================================================
// TENANCY
// ============================================================================

/// The tenant root. Every financial record in the system hangs off exactly one
/// association, and the repository layer scopes all queries by associationId.
model Association {
  id             String            @id @default(cuid())
  /// Short human code used in member payment references, e.g. "RTA".
  code           String            @unique
  name           String
  legalName      String?
  registrationNo String?
  taxId          String?
  logoUrl        String?
  status         AssociationStatus @default(PENDING)

  email        String?
  phone        String?
  website      String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  district     String?
  province     String?
  country      String  @default("Rwanda")

  /// ISO-4217. Drives formatting and any future multi-currency support.
  currency String @default("RWF")
  timezone String @default("Africa/Kigali")
  locale   String @default("en")

  /// Collection account this association receives member payments into.
  bankName          String?
  bankAccountName   String?
  bankAccountNumber String?
  bankBranchCode    String?

  /// Running counter used to mint sequential member payment references
  /// without a table scan. Incremented atomically when a member is created.
  memberRefSequence Int @default(0)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?

  users            User[]
  members          Member[]
  savingsAccounts  SavingsAccount[]
  transactions     SavingsTransaction[]
  withdrawals      Withdrawal[]
  loanProducts     LoanProduct[]
  loanApplications LoanApplication[]
  loans            Loan[]
  loanTransactions LoanTransaction[]
  payments         Payment[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  documents        Document[]
  settings         SystemSetting[]
  savingsRule      SavingsRule?

  /// The association's own side of the balance sheet: what it borrowed and
  /// what it put the money into. See the ASSOCIATION FINANCES section.
  borrowings  InstitutionalLoan[]
  investments AssociationInvestment[]

  /// The rules the association runs on, and the records they produce. See the
  /// RULEBOOK section at the foot of this file.
  rules                 AssociationRule[]
  contributionFines     ContributionFine[]
  contributionStandings MemberContributionStanding[]
  platformFeeCharges    PlatformFeeCharge[]
  interestDistributions InterestDistribution[]

  bkTransactions BkTransaction[]
  bkPaymentClaims BkPaymentClaim[]

  /// The store of fabric, machines and tools the association buys in bulk and
  /// hands to members. See the WAREHOUSE section at the foot of this file.
  warehouseItems     WarehouseItem[]
  warehouseMovements WarehouseStockMovement[]
  warehouseIssuances WarehouseIssuance[]

  /// Goods taken on credit, and what falling behind on them cost. See the
  /// WAREHOUSE CREDIT section at the foot of this file.
  warehouseCredits        WarehouseCredit[]
  warehouseCreditPayments WarehouseCreditPayment[]
  warehouseCreditFines    WarehouseCreditFine[]

  @@index([status])
  @@map("associations")
}

// ============================================================================
// IDENTITY, AUTH & ACCESS CONTROL
// ============================================================================

/// An authentication identity. Exactly one User backs each Member, but admins
/// and super admins exist as Users with no Member record.
/// SUPER_ADMIN rows carry associationId = null (platform scope).
model User {
  id            String       @id @default(cuid())
  associationId String?
  association   Association? @relation(fields: [associationId], references: [id], onDelete: Restrict)

  email     String?
  /// E.164, e.g. +250788123456. Normalised on write.
  phone     String?
  firstName String
  lastName  String
  avatarUrl String?

  /// Office held in the association — "Chairman", "Treasurer", "Secretary".
  /// Deliberately separate from `role`: role is what the software permits them
  /// to do, this is what the membership card prints under their name. Null
  /// falls back to the role label, so an ordinary member's card still reads
  /// sensibly without anyone filling this in.
  title String?

  /// Argon2id hash. Never a plaintext or reversible value.
  passwordHash       String
  passwordChangedAt  DateTime?
  mustChangePassword Boolean   @default(false)

  role   UserRole   @default(MEMBER)
  status UserStatus @default(PENDING_VERIFICATION)

  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?

  /// Brute-force protection. Reset on a successful login.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  lastLoginIp         String?

  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String?

  createdById  String?
  createdBy    User?   @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers User[]  @relation("UserCreatedBy")

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deactivatedAt DateTime?

  member             Member?
  sessions           Session[]
  loginActivities    LoginActivity[]
  verificationTokens VerificationToken[]
  accessQrCodes      AccessQrCode[]
  avatar             UserAvatar?
  permissions        UserPermission[]
  notifications      Notification[]
  auditLogs          AuditLog[]

  // Reverse relations for the many "who did this" columns across the system.
  uploadedDocuments    Document[]              @relation("DocumentUploadedBy")
  verifiedDocuments    Document[]              @relation("DocumentVerifiedBy")
  postedTransactions   SavingsTransaction[]    @relation("TransactionPostedBy")
  reversedTransactions SavingsTransaction[]    @relation("TransactionReversedBy")
  reviewedWithdrawals  Withdrawal[]            @relation("WithdrawalReviewedBy")
  processedWithdrawals Withdrawal[]            @relation("WithdrawalProcessedBy")
  reviewedApplications LoanApplication[]       @relation("ApplicationReviewedBy")
  decidedApplications  LoanApplication[]       @relation("ApplicationDecidedBy")
  disbursedLoans       Loan[]                  @relation("LoanDisbursedBy")
  postedLoanTxns       LoanTransaction[]       @relation("LoanTransactionPostedBy")
  reconciliations      PaymentReconciliation[] @relation("ReconciliationPerformedBy")
  matchedPayments      Payment[]               @relation("PaymentMatchedBy")
  memberNotes          MemberNote[]            @relation("MemberNoteAuthor")
  settingUpdates       SystemSetting[]         @relation("SettingUpdatedBy")

  recordedBorrowings  InstitutionalLoan[]          @relation("BorrowingRecordedBy")
  recordedRepayments  InstitutionalLoanRepayment[] @relation("BorrowingRepaymentRecordedBy")
  recordedInvestments AssociationInvestment[]      @relation("InvestmentRecordedBy")

  createdWarehouseItems     WarehouseItem[]          @relation("WarehouseItemCreatedBy")
  recordedStockMovements    WarehouseStockMovement[] @relation("WarehouseMovementRecordedBy")
  warehouseIssuancesMade    WarehouseIssuance[]      @relation("WarehouseIssuedBy")
  warehouseCreditsOpened       WarehouseCredit[]            @relation("WarehouseCreditOpenedBy")
  warehouseCreditPaymentsTaken WarehouseCreditPayment[]     @relation("WarehouseCreditPaymentRecordedBy")
  warehouseInstalmentsWaived   WarehouseCreditInstallment[] @relation("WarehouseInstallmentWaivedBy")
  warehouseFinesAssessed       WarehouseCreditFine[]        @relation("WarehouseFineAssessedBy")
  warehouseFinesWaived         WarehouseCreditFine[]        @relation("WarehouseFineWaivedBy")

  createdRules        AssociationRule[]         @relation("RuleCreatedBy")
  updatedRules        AssociationRule[]         @relation("RuleUpdatedBy")
  ruleRevisions       AssociationRuleRevision[] @relation("RuleRevisionChangedBy")
  assessedFines       ContributionFine[]        @relation("FineAssessedBy")
  waivedFines         ContributionFine[]        @relation("FineWaivedBy")
  chargedPlatformFees PlatformFeeCharge[]       @relation("PlatformFeeChargedBy")

  // BK transaction matching
  matchedBkTransactions BkTransaction[]        @relation("BkTransactionMatchedBy")
  bkReconciliations   BkTransactionReconciliation[] @relation("BkReconciliationPerformedBy")
  bkSyncLogs           BkSyncLog[]            @relation("BkSyncTriggeredBy")
  bkPaymentClaims      BkPaymentClaim[]       @relation("BkClaimCreatedBy")

  @@unique([email])
  @@unique([phone])
  @@index([associationId, role])
  @@index([associationId, status])
  @@index([role, status])
  @@map("users")
}

/// Server-side session record. Sessions are stored (not purely stateless JWTs)
/// so that an admin can revoke access immediately — a suspended member must
/// lose access on the next request, not when their token happens to expire.
model Session {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// SHA-256 of the opaque session token. The raw token is only ever in the
  /// user's cookie, so a database leak does not hand over live sessions.
  tokenHash     String    @unique
  ipAddress     String?
  userAgent     String?
  expiresAt     DateTime
  lastSeenAt    DateTime  @default(now())
  revokedAt     DateTime?
  revokedReason String?
  createdAt     DateTime  @default(now())

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

model LoginActivity {
  id     String  @id @default(cuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// Captured even on failure, where userId may be null (unknown account).
  identifier    String
  success       Boolean
  failureReason String?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
  @@index([identifier, createdAt])
  @@index([createdAt])
  @@map("login_activities")
}

model VerificationToken {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// SHA-256 of the emailed/SMS-ed token, same reasoning as Session.tokenHash.
  tokenHash  String       @unique
  purpose    TokenPurpose
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime     @default(now())

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("verification_tokens")
}

/// A printable sign-in QR code. Scanning it signs the holder straight into
/// their own account, which is how a tailor with a feature-phone-shaped
/// relationship to passwords gets to their balance without typing one.
///
/// TREAT THIS ROW AS A CREDENTIAL. The secret encoded in the image is a bearer
/// token: whoever photographs the printed card can sign in as its owner until
/// it expires or is revoked. That is the deliberate trade — the same trade a
/// bank card makes — and it is why every code carries an expiry, why issuing a
/// new one revokes the old, and why every issue, scan and revocation is
/// audited.
/// The photograph printed on a membership card.
///
/// A TABLE OF ITS OWN, NOT A COLUMN ON `users`. The bytes are the largest
/// thing the account owns, and a `findMany` that forgets to `select` would
/// otherwise drag every member's photograph across the wire to render a list
/// of names. Keeping it separate makes that impossible rather than merely
/// discouraged.
///
/// Stored in the database rather than on disk because the app runs on Render,
/// whose filesystem is ephemeral — a photograph written next to the process
/// would vanish on the next deploy. There is no object store configured, and
/// a card photograph resized to 512px is a few tens of kilobytes.
model UserAvatar {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  data      Bytes
  mimeType  String
  /// Bytes, kept alongside so a size check never has to load the image.
  sizeBytes Int
  /// Longest edge in pixels, recorded at upload so the card renderer can tell
  /// a usable photograph from one too small to print at 300dpi.
  width     Int
  height    Int

  uploadedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("user_avatars")
}

model AccessQrCode {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// SHA-256 of the secret carried in the image — the lookup key when a code
  /// is scanned. Same reasoning as Session.tokenHash: the digest alone cannot
  /// be turned back into a scannable code.
  tokenHash String @unique

  /// AES-256-GCM ciphertext of that same secret, so the card can be redrawn
  /// and downloaded again months later without issuing a new one. The key is
  /// derived from SESSION_SECRET, which lives in the environment — a database
  /// dump on its own still yields nothing that can be scanned.
  secretCipher String

  /// Optional note, e.g. "printed card" vs "phone wallpaper".
  label String?

  issuedAt  DateTime @default(now())
  /// Never null. An access credential with no expiry is one that outlives the
  /// membership it belongs to.
  expiresAt DateTime

  lastUsedAt DateTime?
  lastUsedIp String?
  useCount   Int       @default(0)

  revokedAt     DateTime?
  revokedReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("access_qr_codes")
}

/// Fine-grained capability, e.g. "loans.approve". Role grants supply the
/// defaults; UserPermission rows add or revoke on top of them.
model Permission {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  category    String
  createdAt   DateTime @default(now())

  roles RolePermission[]
  users UserPermission[]

  @@index([category])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(cuid())
  role         UserRole
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([role, permissionId])
  @@index([role])
  @@map("role_permissions")
}

/// Per-user override. `granted = false` revokes a permission the user's role
/// would otherwise give, which is why this is not a simple join table.
model UserPermission {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  granted      Boolean    @default(true)
  grantedById  String?
  expiresAt    DateTime?
  createdAt    DateTime   @default(now())

  @@unique([userId, permissionId])
  @@index([userId])
  @@map("user_permissions")
}

// ============================================================================
// MEMBERS
// ============================================================================

model Member {
  id            String      @id @default(cuid())
  associationId String
  association   Association @relation(fields: [associationId], references: [id], onDelete: Restrict)

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  /// Human-facing membership number, unique inside the association.
  memberNumber String

  /// THE primary payment-matching key. Globally unique and printed on every
  /// payment instruction given to the member, e.g. "RTA-000123". A payment
  /// carrying this reference can be attributed with full confidence.
  paymentReference String @unique

  status    MemberStatus @default(PENDING_APPROVAL)
  kycStatus KycStatus    @default(UNVERIFIED)

  nationalId   String?
  dateOfBirth  DateTime?
  gender       Gender?
  occupation   String?
  businessName String?

  addressLine1 String?
  city         String?
  district     String?
  province     String?

  /// Alternate identifiers used as fallback matching keys, in the order
  /// defined by MatchStrategy. Normalised to E.164 / plain digits on write.
  mobileMoneyNumber String?
  bankAccountNumber String?

  nextOfKinName     String?
  nextOfKinPhone    String?
  nextOfKinRelation String?

  joinedAt         DateTime?
  approvedAt       DateTime?
  approvedById     String?
  suspendedAt      DateTime?
  suspensionReason String?
  exitedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  savingsAccounts  SavingsAccount[]
  transactions     SavingsTransaction[]
  withdrawals      Withdrawal[]
  loanApplications LoanApplication[]
  loans            Loan[]
  payments         Payment[]
  documents        Document[]
  notes            MemberNote[]
  guarantorFor     Guarantor[]

  contributionFines     ContributionFine[]
  contributionStanding  MemberContributionStanding?
  platformFeeCharges    PlatformFeeCharge[]
  interestDistributions InterestDistribution[]

  bkTransactions BkTransaction[]
  bkPaymentClaims BkPaymentClaim[]

  /// Everything this member has taken out of the warehouse, what they are
  /// paying off over months, and any fine for missing one.
  warehouseIssuances   WarehouseIssuance[]
  warehouseCredits     WarehouseCredit[]
  warehouseCreditFines WarehouseCreditFine[]

  @@unique([associationId, memberNumber])
  @@index([associationId, status])
  @@index([associationId, kycStatus])
  @@index([mobileMoneyNumber])
  @@index([bankAccountNumber])
  @@index([nationalId])
  @@map("members")
}

/// Free-text admin annotations on a member file. Append-only by convention.
model MemberNote {
  id         String   @id @default(cuid())
  memberId   String
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation("MemberNoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  body       String
  /// Internal notes are hidden from the member's own portal.
  isInternal Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([memberId, createdAt])
  @@map("member_notes")
}

// ============================================================================
// SAVINGS — ACCOUNTS & LEDGER
// ============================================================================

model SavingsAccount {
  id            String      @id @default(cuid())
  associationId String
  association   Association @relation(fields: [associationId], references: [id], onDelete: Restrict)
  memberId      String
  member        Member      @relation(fields: [memberId], references: [id], onDelete: Restrict)

  accountNumber String @unique

  /// CACHED balance. Only ever written inside the same DB transaction that
  /// appends a SavingsTransaction, with this row locked FOR UPDATE. It must
  /// always equal the balanceAfter of the highest-sequence ledger row.
  balance Decimal @default(0) @db.Decimal(18, 2)

  /// Portion of `balance` pledged against active loans or pending
  /// withdrawals; availableBalance = balance - lockedBalance.
  lockedBalance Decimal @default(0) @db.Decimal(18, 2)

  /// Running totals maintained alongside the ledger for cheap dashboards.
  /// Derived values — never a source of truth.
  totalDeposits    Decimal @default(0) @db.Decimal(18, 2)
  totalWithdrawals Decimal @default(0) @db.Decimal(18, 2)
  totalInterest    Decimal @default(0) @db.Decimal(18, 2)
  totalFees        Decimal @default(0) @db.Decimal(18, 2)

  /// Monotonic per-account counter. The next ledger row takes
  /// lastSequence + 1, which makes gaps and replays detectable.
  lastSequence Int @default(0)

  currency          String    @default("RWF")
  isActive          Boolean   @default(true)
  openedAt          DateTime  @default(now())
  closedAt          DateTime?
  lastTransactionAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions SavingsTransaction[]
  withdrawals  Withdrawal[]

  @@index([associationId, isActive])
  @@index([memberId])
  @@map("savings_accounts")
}

/// THE SAVINGS LEDGER. Append-only: rows are never updated (except `status`
/// on a reversal) and never deleted. Balance history is reconstructable by
/// replaying rows in `sequence` order.
model SavingsTransaction {
  id               String         @id @default(cuid())
  associationId    String
  association      Association    @relation(fields: [associationId], references: [id], onDelete: Restrict)
  savingsAccountId String
  savingsAccount   SavingsAccount @relation(fields: [savingsAccountId], references: [id], onDelete: Restrict)
  memberId         String
  member           Member         @relation(fields: [memberId], references: [id], onDelete: Restrict)

  /// Position in this account's ledger. Unique per account — the database
  /// itself rejects two concurrent writers trying to claim the same slot.
  sequence Int

  /// Member-facing transaction id, e.g. "TXN-2026-0001234".
  reference String @unique

  type      TransactionType
  direction TransactionDirection
  status    TransactionStatus    @default(COMPLETED)
  channel   PaymentChannel       @default(INTERNAL_TRANSFER)

  /// Always positive. Direction carries the sign.
  amount        Decimal @db.Decimal(18, 2)
  balanceBefore Decimal @db.Decimal(18, 2)
  balanceAfter  Decimal @db.Decimal(18, 2)
  currency      String  @default("RWF")

  description       String?
  /// Provider-side reference, mirrored here for statement display and search.
  externalReference String?

  // Source linkage — every ledger row is traceable back to what caused it.
  paymentId         String?          @unique
  payment           Payment?         @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  withdrawalId      String?
  withdrawal        Withdrawal?      @relation(fields: [withdrawalId], references: [id], onDelete: SetNull)
  loanId            String?
  loan              Loan?            @relation(fields: [loanId], references: [id], onDelete: SetNull)
  loanTransactionId String?
  loanTransaction   LoanTransaction? @relation(fields: [loanTransactionId], references: [id], onDelete: SetNull)

  // Corrections: a reversal points at the row it cancels. Both rows survive.
  reversalOfId   String?             @unique
  reversalOf     SavingsTransaction? @relation("TransactionReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy     SavingsTransaction? @relation("TransactionReversal")
  reversalReason String?

  /// Null when posted by the system (reconciliation, cron, accruals).
  postedById     String?
  postedBy       User?   @relation("TransactionPostedBy", fields: [postedById], references: [id], onDelete: SetNull)
  reversedById   String?
  reversedByUser User?   @relation("TransactionReversedBy", fields: [reversedById], references: [id], onDelete: SetNull)

  /// Mandatory justification for manual ADJUSTMENT rows — enforced in the
  /// service layer, which refuses to post an adjustment without one.
  adjustmentReason String?

  valueDate DateTime @default(now())
  createdAt DateTime @default(now())

  /// Back-references from the rulebook records that caused this row. All three
  /// are optional and mutually exclusive; they exist so a service can ask "was
  /// this fee the platform's, or the association's?" of the ledger row itself.
  /// Without them the association's income reports would count the platform's
  /// service fee as association income.
  platformFeeCharge    PlatformFeeCharge?
  contributionFine     ContributionFine?
  interestDistribution InterestDistribution?
  /// Set when this debit paid for goods taken out of the warehouse.
  warehouseIssuance    WarehouseIssuance?
  /// Set when this debit paid an instalment on goods bought on credit.
  warehouseCreditPayment WarehouseCreditPayment?

  @@unique([savingsAccountId, sequence])
  @@index([associationId, createdAt])
  @@index([associationId, type, createdAt])
  @@index([savingsAccountId, createdAt])
  @@index([memberId, createdAt])
  @@index([externalReference])
  @@map("savings_transactions")
}

/// Per-association savings policy. Separate from LoanProduct because savings
/// rules apply association-wide rather than per product.
model SavingsRule {
  id            String      @id @default(cuid())
  associationId String      @unique
  association   Association @relation(fields: [associationId], references: [id], onDelete: Cascade)

  minimumDeposit Decimal  @default(0) @db.Decimal(18, 2)
  maximumDeposit Decimal? @db.Decimal(18, 2)
  minimumBalance Decimal  @default(0) @db.Decimal(18, 2)

  allowWithdrawals           Boolean    @default(true)
  withdrawalRequiresApproval Boolean    @default(true)
  minimumWithdrawal          Decimal    @default(0) @db.Decimal(18, 2)
  maximumWithdrawal          Decimal?   @db.Decimal(18, 2)
  withdrawalFeeType          ChargeType @default(FIXED)
  withdrawalFeeValue         Decimal    @default(0) @db.Decimal(18, 2)
  withdrawalNoticeDays       Int        @default(0)

  /// Monthly obligation, if the association enforces one.
  monthlyContribution Decimal? @db.Decimal(18, 2)
  contributionDueDay  Int?

  annualInterestRate Decimal @default(0) @db.Decimal(9, 4)
  interestPostingDay Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("savings_rules")
}

model Withdrawal {
  id               String         @id @default(cuid())
  associationId    String
  association      Association    @relation(fields: [associationId], references: [id], onDelete: Restrict)
  memberId         String
  member           Member         @relation(fields: [memberId], references: [id], onDelete: Restrict)
  savingsAccountId String
  savingsAccount   SavingsAccount @relation(fields: [savingsAccountId], references: [id], onDelete: Restrict)

  reference String  @unique
  amount    Decimal @db.Decimal(18, 2)
  fee       Decimal @default(0) @db.Decimal(18, 2)
  netAmount Decimal @db.Decimal(18, 2)
  currency  String  @default("RWF")

  status            WithdrawalStatus @default(PENDING)
  reason            String?
  channel           PaymentChannel   @default(BANK_TRANSFER)
  destinationDetail String?

  /// Snapshot of the balance when the request was raised, for audit context.
  balanceAtRequest Decimal @db.Decimal(18, 2)

  reviewedById    String?
  reviewedBy      User?     @relation("WithdrawalReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?
  reviewNotes     String?
  rejectionReason String?

  processedById     String?
  processedBy       User?     @relation("WithdrawalProcessedBy", fields: [processedById], references: [id], onDelete: SetNull)
  processedAt       DateTime?
  externalReference String?

  requestedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  transactions SavingsTransaction[]

  @@index([associationId, status, requestedAt])
  @@index([memberId, requestedAt])
  @@map("withdrawals")
}

// ============================================================================
// PAYMENTS — PROVIDER CAPTURE & RECONCILIATION
// ============================================================================

/// Raw inbound payment as reported by a payment provider (Jenga/Equity today).
/// Captured verbatim BEFORE any interpretation, so the original provider
/// record survives regardless of what the matching engine later decides.
///
/// Idempotency lives here: the unique constraints below make it impossible for
/// a replayed webhook or an overlapping poll window to create a second row for
/// the same provider transaction, which is what would otherwise double-credit.
model Payment {
  id            String       @id @default(cuid())
  /// Nullable: a payment that cannot be attributed to any association yet is
  /// still captured rather than dropped.
  associationId String?
  association   Association? @relation(fields: [associationId], references: [id], onDelete: Restrict)

  provider String         @default("JENGA")
  channel  PaymentChannel @default(JENGA_EQUITY)

  /// The provider's own transaction id. Unique per provider — this is the
  /// primary duplicate guard.
  externalTransactionId String
  /// The provider's secondary reference (Jenga returns both an id and a
  /// reference). Also provider-generated and therefore safe to constrain as
  /// unique-when-present.
  ///
  /// This is NOT the payer's narration. Narration is free text that two
  /// different payments can legitimately share — a member paying twice in the
  /// same week may type the same thing both times — so constraining it would
  /// reject the second real payment as a duplicate. Payer text lives in
  /// `narration` below, and that is the field the matching engine reads a
  /// member payment reference out of.
  transactionReference  String?

  amount   Decimal @db.Decimal(18, 2)
  currency String  @default("RWF")

  /// Provider's verbatim status string, kept unmapped for audit.
  providerStatus String?
  status         PaymentStatus @default(RECEIVED)

  payerName     String?
  payerPhone    String?
  payerAccount  String?
  payerBank     String?
  /// Free text supplied by the payer. Deliberately NOT unique. The matching
  /// engine scans this for a member payment reference.
  narration     String?
  debitAccount  String?
  creditAccount String?

  transactionDate DateTime
  valueDate       DateTime?

  /// Untouched provider response. Never parsed for authority — only for
  /// audit, debugging and dispute resolution.
  rawPayload Json?

  /// How the record arrived: "WEBHOOK" | "POLL" | "MANUAL".
  ingestSource         String    @default("POLL")
  /// Set when the provider was re-queried and confirmed the transaction as
  /// successful. A payment is never posted to the ledger without this.
  verifiedAt           DateTime?
  verificationResponse Json?

  matchedMemberId String?
  matchedMember   Member?       @relation(fields: [matchedMemberId], references: [id], onDelete: SetNull)
  matchStrategy   MatchStrategy @default(NONE)
  /// 0–100. Anything below the configured threshold goes to UNMATCHED rather
  /// than being auto-credited.
  matchConfidence Int           @default(0)
  matchedById     String?
  matchedBy       User?         @relation("PaymentMatchedBy", fields: [matchedById], references: [id], onDelete: SetNull)
  matchedAt       DateTime?

  processedAt   DateTime?
  failureReason String?
  retryCount    Int       @default(0)
  lastRetryAt   DateTime?
  nextRetryAt   DateTime?

  /// Raised by the fraud checks (unusual amount, repeated payer, etc.).
  isSuspicious    Boolean @default(false)
  suspicionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  savingsTransaction SavingsTransaction?
  reconciliations    PaymentReconciliation[]

  bkTransaction BkTransaction?

  @@unique([provider, externalTransactionId])
  @@unique([provider, transactionReference])
  @@index([status, transactionDate])
  @@index([associationId, status])
  @@index([matchedMemberId])
  @@index([payerPhone])
  @@index([nextRetryAt])
  @@index([isSuspicious])
  @@map("payments")
}

/// One row per matching/processing attempt against a Payment. This is the
/// audit trail that answers "why was this credited to this member?" — and for
/// manual reconciliation, "which admin decided that, and on what grounds?".
model PaymentReconciliation {
  id        String  @id @default(cuid())
  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  attempt    Int                   @default(1)
  outcome    ReconciliationOutcome
  strategy   MatchStrategy         @default(NONE)
  confidence Int                   @default(0)

  /// Members the engine considered, for AMBIGUOUS outcomes.
  candidateIds     String[]
  resolvedMemberId String?

  notes         String?
  errorMessage  String?
  /// Null for automated runs; set for MANUAL_OVERRIDE.
  performedById String?
  performedBy   User?   @relation("ReconciliationPerformedBy", fields: [performedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([paymentId, attempt])
  @@index([outcome, createdAt])
  @@map("payment_reconciliations")
}

/// Generic idempotency guard for mutating API calls. A client retrying a
/// request with the same key gets the stored response instead of a second
/// side effect.
model IdempotencyKey {
  id           String    @id @default(cuid())
  key          String    @unique
  scope        String
  userId       String?
  requestHash  String
  responseCode Int?
  responseBody Json?
  lockedAt     DateTime?
  completedAt  DateTime?
  expiresAt    DateTime
  createdAt    DateTime  @default(now())

  @@index([expiresAt])
  @@map("idempotency_keys")
}

// ============================================================================
// LOANS
// ============================================================================

/// Configurable loan rules. Eligibility and pricing are DATA, not code — an
/// association can define several products with different limits and rates
/// without any change to the application.
model LoanProduct {
  id            String      @id @default(cuid())
  associationId String
  association   Association @relation(fields: [associationId], references: [id], onDelete: Cascade)

  name        String
  code        String
  description String?
  isActive    Boolean @default(true)

  // Eligibility
  minimumSavings          Decimal  @default(0) @db.Decimal(18, 2)
  /// Maximum loan = savings × this multiplier (the "3× savings" rule, made
  /// configurable rather than hard-coded).
  savingsMultiplier       Decimal  @default(3) @db.Decimal(9, 2)
  minimumMembershipMonths Int      @default(0)
  minAmount               Decimal  @default(0) @db.Decimal(18, 2)
  maxAmount               Decimal  @db.Decimal(18, 2)
  /// Hard ceiling applied after the multiplier calculation.
  absoluteMaxAmount       Decimal? @db.Decimal(18, 2)

  // Pricing
  interestRate   Decimal        @db.Decimal(9, 4)
  interestMethod InterestMethod @default(REDUCING_BALANCE)
  /// Period the rate is quoted over: "ANNUAL" | "MONTHLY".
  interestPeriod String         @default("ANNUAL")

  processingFeeType  ChargeType @default(PERCENTAGE)
  processingFeeValue Decimal    @default(0) @db.Decimal(18, 2)
  insuranceFeeType   ChargeType @default(PERCENTAGE)
  insuranceFeeValue  Decimal    @default(0) @db.Decimal(18, 2)

  penaltyType      ChargeType @default(PERCENTAGE)
  penaltyValue     Decimal    @default(0) @db.Decimal(18, 2)
  penaltyGraceDays Int        @default(0)

  // Term
  minTermMonths      Int                  @default(1)
  maxTermMonths      Int                  @default(24)
  gracePeriodDays    Int                  @default(0)
  allowedFrequencies RepaymentFrequency[]
  defaultFrequency   RepaymentFrequency   @default(MONTHLY)

  // Guarantors & collateral
  requiresGuarantors Boolean @default(false)
  minimumGuarantors  Int     @default(0)
  requiresCollateral Boolean @default(false)

  /// Only one active loan of this product per member when true.
  singleActiveLoan Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applications LoanApplication[]
  loans        Loan[]

  @@unique([associationId, code])
  @@index([associationId, isActive])
  @@map("loan_products")
}

model LoanApplication {
  id            String      @id @default(cuid())
  associationId String
  association   Association @relation(fields: [associationId], references: [id], onDelete: Restrict)
  memberId      String
  member        Member      @relation(fields: [memberId], references: [id], onDelete: Restrict)
  loanProductId String
  loanProduct   LoanProduct @relation(fields: [loanProductId], references: [id], onDelete: Restrict)

  reference String                @unique
  status    LoanApplicationStatus @default(DRAFT)

  requestedAmount Decimal            @db.Decimal(18, 2)
  purpose         String
  termMonths      Int
  frequency       RepaymentFrequency @default(MONTHLY)

  /// Eligibility snapshot at submission time — what the member's savings and
  /// computed ceiling were when they applied, so a later approval can be
  /// judged against the facts that existed then.
  savingsAtApplication Decimal? @db.Decimal(18, 2)
  maxEligibleAmount    Decimal? @db.Decimal(18, 2)
  eligibilityPassed    Boolean?
  eligibilityReport    Json?

  // Decision
  approvedAmount     Decimal?            @db.Decimal(18, 2)
  approvedRate       Decimal?            @db.Decimal(9, 4)
  approvedTermMonths Int?
  approvedFrequency  RepaymentFrequency?

  submittedAt  DateTime?
  reviewedById String?
  reviewedBy   User?     @relation("ApplicationReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  reviewNotes  String?

  decidedById     String?
  decidedBy       User?     @relation("ApplicationDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt       DateTime?
  rejectionReason String?
  infoRequested   String?
  infoRequestedAt DateTime?

  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  loan          Loan?
  guarantors    Guarantor[]
  documents     Document[]
  statusHistory LoanApplicationEvent[]

  @@index([associationId, status, submittedAt])
  @@index([memberId, createdAt])
  @@map("loan_applications")
}

/// Immutable trail of every state change on an application.
model LoanApplicationEvent {
  id            String                 @id @default(cuid())
  applicationId String
  application   LoanApplication        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromStatus    LoanApplicationStatus?
  toStatus      LoanApplicationStatus
  actorId       String?
  note          String?
  createdAt     DateTime               @default(now())

  @@index([applicationId, createdAt])
  @@map("loan_application_events")
}

model Loan {
  id            String           @id @default(cuid())
  associationId String
  association   Association      @relation(fields: [associationId], references: [id], onDelete: Restrict)
  memberId      String
  member        Member           @relation(fields: [memberId], references: [id], onDelete: Restrict)
  loanProductId String
  loanProduct   LoanProduct      @relation(fields: [loanProductId], references: [id], onDelete: Restrict)
  applicationId String?          @unique
  application   LoanApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  reference String     @unique
  status    LoanStatus @default(PENDING_DISBURSEMENT)

  // Terms as approved. Frozen at disbursement.
  principal       Decimal            @db.Decimal(18, 2)
  interestRate    Decimal            @db.Decimal(9, 4)
  interestMethod  InterestMethod
  interestPeriod  String             @default("ANNUAL")
  termMonths      Int
  frequency       RepaymentFrequency
  gracePeriodDays Int                @default(0)
  currency        String             @default("RWF")

  // Computed totals
  totalInterest Decimal @default(0) @db.Decimal(18, 2)
  processingFee Decimal @default(0) @db.Decimal(18, 2)
  insuranceFee  Decimal @default(0) @db.Decimal(18, 2)
  totalFees     Decimal @default(0) @db.Decimal(18, 2)
  totalPayable  Decimal @default(0) @db.Decimal(18, 2)

  // Live outstanding position, split so that repayment allocation is exact.
  principalOutstanding Decimal @default(0) @db.Decimal(18, 2)
  interestOutstanding  Decimal @default(0) @db.Decimal(18, 2)
  feesOutstanding      Decimal @default(0) @db.Decimal(18, 2)
  penaltyOutstanding   Decimal @default(0) @db.Decimal(18, 2)

  principalPaid Decimal @default(0) @db.Decimal(18, 2)
  interestPaid  Decimal @default(0) @db.Decimal(18, 2)
  feesPaid      Decimal @default(0) @db.Decimal(18, 2)
  penaltyPaid   Decimal @default(0) @db.Decimal(18, 2)
  totalPaid     Decimal @default(0) @db.Decimal(18, 2)

  disbursedAmount       Decimal?        @db.Decimal(18, 2)
  disbursedAt           DateTime?
  disbursedById         String?
  disbursedBy           User?           @relation("LoanDisbursedBy", fields: [disbursedById], references: [id], onDelete: SetNull)
  disbursementChannel   PaymentChannel?
  disbursementReference String?

  firstRepaymentDate DateTime?
  maturityDate       DateTime?
  lastRepaymentAt    DateTime?
  completedAt        DateTime?

  daysOverdue   Int       @default(0)
  overdueAmount Decimal   @default(0) @db.Decimal(18, 2)
  defaultedAt   DateTime?
  writtenOffAt  DateTime?

  /// Loan restructuring: the new loan points back at the one it replaced.
  restructuredFromId String? @unique
  restructuredFrom   Loan?   @relation("LoanRestructure", fields: [restructuredFromId], references: [id], onDelete: SetNull)
  restructuredTo     Loan?   @relation("LoanRestructure")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  installments          LoanInstallment[]
  transactions          LoanTransaction[]
  savingsTransactions   SavingsTransaction[]
  guarantors            Guarantor[]
  documents             Document[]
  interestDistributions InterestDistribution[]
  /// Goods issued against this loan, whose value counts toward its collateral.
  warehouseIssuances    WarehouseIssuance[]

  @@index([associationId, status])
  @@index([memberId, status])
  @@index([status, daysOverdue])
  @@index([maturityDate])
  @@map("loans")
}

/// One row per scheduled instalment. Generated at disbursement and updated as
/// repayments are allocated against it.
model LoanInstallment {
  id     String @id @default(cuid())
  loanId String
  loan   Loan   @relation(fields: [loanId], references: [id], onDelete: Cascade)

  installmentNumber Int
  dueDate           DateTime
  status            InstallmentStatus @default(UPCOMING)

  principalDue Decimal @db.Decimal(18, 2)
  interestDue  Decimal @db.Decimal(18, 2)
  feesDue      Decimal @default(0) @db.Decimal(18, 2)
  penaltyDue   Decimal @default(0) @db.Decimal(18, 2)
  totalDue     Decimal @db.Decimal(18, 2)

  principalPaid Decimal @default(0) @db.Decimal(18, 2)
  interestPaid  Decimal @default(0) @db.Decimal(18, 2)
  feesPaid      Decimal @default(0) @db.Decimal(18, 2)
  penaltyPaid   Decimal @default(0) @db.Decimal(18, 2)
  totalPaid     Decimal @default(0) @db.Decimal(18, 2)

  /// Principal still owed after this instalment, per the original schedule.
  balanceAfter Decimal @db.Decimal(18, 2)

  paidAt       DateTime?
  daysOverdue  Int       @default(0)
  waivedAt     DateTime?
  waivedById   String?
  waiverReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  allocations LoanRepaymentAllocation[]

  @@unique([loanId, installmentNumber])
  @@index([loanId, dueDate])
  @@index([status, dueDate])
  @@map("loan_installments")
}

/// THE LOAN LEDGER. Append-only, same discipline as SavingsTransaction.
model LoanTransaction {
  id            String      @id @default(cuid())
  associationId String
  association   Association @relation(fields: [associationId], references: [id], onDelete: Restrict)
  loanId        String
  loan          Loan        @relation(fields: [loanId], references: [id], onDelete: Restrict)

  sequence  Int
  reference String              @unique
  type      LoanTransactionType
  status    TransactionStatus   @default(COMPLETED)
  channel   PaymentChannel      @default(INTERNAL_TRANSFER)

  amount Decimal @db.Decimal(18, 2)

  // Allocation split for REPAYMENT rows.
  principalPortion Decimal @default(0) @db.Decimal(18, 2)
  interestPortion  Decimal @default(0) @db.Decimal(18, 2)
  feesPortion      Decimal @default(0) @db.Decimal(18, 2)
  penaltyPortion   Decimal @default(0) @db.Decimal(18, 2)

  /// Total outstanding across all buckets after this row was posted.
  balanceAfter Decimal @db.Decimal(18, 2)
  currency     String  @default("RWF")

  description       String?
  externalReference String?

  reversalOfId   String?          @unique
  reversalOf     LoanTransaction? @relation("LoanTransactionReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy     LoanTransaction? @relation("LoanTransactionReversal")
  reversalReason String?

  postedById       String?
  postedBy         User?   @relation("LoanTransactionPostedBy", fields: [postedById], references: [id], onDelete: SetNull)
  adjustmentReason String?

  valueDate DateTime @default(now())
  createdAt DateTime @default(now())

  allocations          LoanRepaymentAllocation[]
  savingsTransactions  SavingsTransaction[]
  /// How this repayment's interest was split between the borrower's savings
  /// and the association. Only REPAYMENT rows carrying interest have one.
  interestDistribution InterestDistribution?

  @@unique([loanId, sequence])
  @@index([associationId, createdAt])
  @@index([loanId, createdAt])
  @@index([type, createdAt])
  @@map("loan_transactions")
}

/// Links a repayment to the instalment(s) it settled, with the exact split.
/// Without this, "which instalment did this payment clear?" is unanswerable.
model LoanRepaymentAllocation {
  id                String          @id @default(cuid())
  loanTransactionId String
  loanTransaction   LoanTransaction @relation(fields: [loanTransactionId], references: [id], onDelete: Cascade)
  installmentId     String
  installment       LoanInstallment @relation(fields: [installmentId], references: [id], onDelete: Cascade)

  principalAmount Decimal @default(0) @db.Decimal(18, 2)
  interestAmount  Decimal @default(0) @db.Decimal(18, 2)
  feesAmount      Decimal @default(0) @db.Decimal(18, 2)
  penaltyAmount   Decimal @default(0) @db.Decimal(18, 2)
  totalAmount     Decimal @db.Decimal(18, 2)

  createdAt DateTime @default(now())

  @@unique([loanTransactionId, installmentId])
  @@index([installmentId])
  @@map("loan_repayment_allocations")
}

model Guarantor {
  id            String           @id @default(cuid())
  applicationId String?
  application   LoanApplication? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  loanId        String?
  loan          Loan?            @relation(fields: [loanId], references: [id], onDelete: Cascade)

  /// A guarantor who is a member of the association; external guarantors are
  /// captured by the free-text fields instead.
  guarantorMemberId String?
  guarantorMember   Member? @relation(fields: [guarantorMemberId], references: [id], onDelete: SetNull)

  fullName     String
  phone        String?
  nationalId   String?
  relationship String?

  /// Amount of the loan this guarantor stands for.
  guaranteedAmount Decimal?        @db.Decimal(18, 2)
  status           GuarantorStatus @default(PENDING)
  respondedAt      DateTime?
  declineReason    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([applicationId])
  @@index([loanId])
  @@index([guarantorMemberId, status])
  @@map("guarantors")
}

// ============================================================================
// ASSOCIATION FINANCES — BORROWING & INVESTMENT
// ============================================================================
//
// The models above answer "what does this member have?". These two answer
// "what does the association have, and what did it do with it?" — the question
// members actually ask at a general meeting and which, until now, only the
// treasurer's notebook could answer.
//
// Both are read by an ordinary member, not just by staff. That is the point of
// them: an association that borrows against its members' savings owes those
// members a plain account of the debt and of what it bought.

/// Money the ASSOCIATION borrowed — typically a bank facility taken against
/// the members' pooled savings so the association can lend or invest beyond
/// what it holds.
///
/// A LIABILITY, not a Loan. `Loan` requires a memberId and reduces as a member
/// repays the association; this reduces as the association repays a bank. They
/// share no rows and must never be summed together.
model InstitutionalLoan {
  id            String      @id @default(cuid())
  associationId String
  association   Association @relation(fields: [associationId], references: [id], onDelete: Restrict)

  /// Member-facing identifier, e.g. "BRW-2026-0001".
  reference String                  @unique
  status    InstitutionalLoanStatus @default(PENDING_DISBURSEMENT)

  lenderName      String
  lenderType      LenderType @default(BANK)
  lenderReference String?
  lenderContact   String?

  /// Why the association took this on, in words a member can read. Shown
  /// verbatim on the member-facing page — this is the honesty the model
  /// exists for, so it is required rather than optional.
  purpose String

  principal      Decimal        @db.Decimal(18, 2)
  interestRate   Decimal        @db.Decimal(9, 4)
  interestMethod InterestMethod @default(REDUCING_BALANCE)
  interestPeriod String         @default("ANNUAL")
  termMonths     Int
  currency       String         @default("RWF")

  /// Total cost as contracted, so a member can see the whole obligation
  /// rather than only the principal.
  totalInterest Decimal @default(0) @db.Decimal(18, 2)
  totalFees     Decimal @default(0) @db.Decimal(18, 2)
  totalPayable  Decimal @default(0) @db.Decimal(18, 2)

  /// Live position. Maintained alongside the repayment ledger inside the same
  /// transaction, under the same discipline as SavingsAccount.balance: a
  /// cache that must always equal the replayed history.
  principalOutstanding Decimal @default(0) @db.Decimal(18, 2)
  interestOutstanding  Decimal @default(0) @db.Decimal(18, 2)

  principalRepaid Decimal @default(0) @db.Decimal(18, 2)
  interestPaid    Decimal @default(0) @db.Decimal(18, 2)
  feesPaid        Decimal @default(0) @db.Decimal(18, 2)
  totalRepaid     Decimal @default(0) @db.Decimal(18, 2)

  /// Monotonic counter for the repayment ledger below.
  lastSequence Int @default(0)

  /// Security pledged. Usually the members' own savings, which is precisely
  /// why members must be able to read this row.
  collateralDescription String?
  collateralAmount      Decimal? @db.Decimal(18, 2)

  disbursedAt     DateTime?
  firstPaymentDue DateTime?
  nextPaymentDue  DateTime?
  maturityDate    DateTime?
  completedAt     DateTime?

  daysOverdue   Int     @default(0)
  overdueAmount Decimal @default(0) @db.Decimal(18, 2)

  /// Withheld from the member-facing page while false. The default is true:
  /// a facility secured on members' savings is theirs to know about, and
  /// hiding one has to be a deliberate act with a reason recorded in the
  /// audit log, not the effect of forgetting a checkbox.
  isPublic Boolean @default(true)

  recordedById String?
  recordedBy   User?   @relation("BorrowingRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  repayments  InstitutionalLoanRepayment[]
  investments AssociationInvestment[]

  @@index([associationId, status])
  @@index([associationId, isPublic])
  @@index([nextPaymentDue])
  @@map("institutional_loans")
}

/// THE BORROWING LEDGER. Append-only, same discipline as LoanTransaction:
/// rows are never edited, and the loan's outstanding position is only ever
/// written in the transaction that appends one.
model InstitutionalLoanRepayment {
  id                  String            @id @default(cuid())
  institutionalLoanId String
  institutionalLoan   InstitutionalLoan @relation(fields: [institutionalLoanId], references: [id], onDelete: Restrict)

  sequence  Int
  reference String @unique

  amount           Decimal @db.Decimal(18, 2)
  principalPortion Decimal @default(0) @db.Decimal(18, 2)
  interestPortion  Decimal @default(0) @db.Decimal(18, 2)
  feesPortion      Decimal @default(0) @db.Decimal(18, 2)

  /// Total still owed across principal and interest after this row.
  balanceAfter Decimal        @db.Decimal(18, 2)
  currency     String         @default("RWF")
  channel      PaymentChannel @default(BANK_TRANSFER)

  description       String?
  externalReference String?

  paidAt       DateTime @default(now())
  recordedById String?
  recordedBy   User?    @relation("BorrowingRepaymentRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@unique([institutionalLoanId, sequence])
  @@index([institutionalLoanId, paidAt])
  @@map("institutional_loan_repayments")
}

/// What the association did with the money — the answer to "what did our
/// savings actually buy us?".
///
/// `benefitSummary` is not decoration. A member reading that the association
/// spent 4,000,000 on equipment learns nothing; reading that it bought two
/// industrial machines now used by thirty tailors is the whole point of
/// showing them the figure at all.
model AssociationInvestment {
  id            String      @id @default(cuid())
  associationId String
  association   Association @relation(fields: [associationId], references: [id], onDelete: Restrict)

  reference String             @unique
  title     String
  category  InvestmentCategory @default(OTHER)
  status    InvestmentStatus   @default(PLANNED)

  /// One or two sentences for the card; the long form for the detail view.
  summary     String
  description String?

  /// What members get out of it, in their own terms.
  benefitSummary   String?
  membersBenefited Int?

  fundingSource  FundingSource      @default(MEMBER_SAVINGS)
  /// Set when a bank facility paid for this, so a member can follow the money
  /// from the debt the association took on to the thing it bought.
  fundedByLoanId String?
  fundedByLoan   InstitutionalLoan? @relation(fields: [fundedByLoanId], references: [id], onDelete: SetNull)

  amountInvested Decimal @db.Decimal(18, 2)
  /// Money this has handed back so far — rent, sales, savings on bulk buying.
  /// Realised only: a projection belongs in `description`, not in a column
  /// that feeds the surplus a member is shown.
  amountReturned Decimal @default(0) @db.Decimal(18, 2)
  currency       String  @default("RWF")

  startedAt   DateTime?
  completedAt DateTime?

  /// Same reasoning as InstitutionalLoan.isPublic.
  isPublic Boolean @default(true)

  recordedById String?
  recordedBy   User?   @relation("InvestmentRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([associationId, status])
  @@index([associationId, isPublic])
  @@index([fundedByLoanId])
  @@map("association_investments")
}

// ============================================================================
// NOTIFICATIONS
// ============================================================================

model Notification {
  id            String       @id @default(cuid())
  associationId String?
  association   Association? @relation(fields: [associationId], references: [id], onDelete: Cascade)
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Stable machine key, e.g. "PAYMENT_RECEIVED", used for templating and
  /// per-user channel preferences.
  eventType String
  title     String
  body      String
  severity  NotificationSeverity @default(INFO)

  /// Deep link into the dashboard, e.g. "/dashboard/member/savings".
  actionUrl  String?
  /// Entity this notification refers to, for grouping and navigation.
  entityType String?
  entityId   String?
  metadata   Json?

  readAt    DateTime?
  createdAt DateTime  @default(now())

  deliveries NotificationDelivery[]

  @@index([userId, readAt, createdAt])
  @@index([associationId, eventType, createdAt])
  @@map("notifications")
}

/// One row per channel attempt. Keeping delivery separate from the
/// notification itself is what lets the SMS provider be swapped without
/// touching notification history.
model NotificationDelivery {
  id             String       @id @default(cuid())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  channel           NotificationChannel
  status            NotificationStatus  @default(PENDING)
  /// Which adapter handled it, e.g. "SMTP", "TWILIO", "AFRICASTALKING".
  provider          String?
  destination       String?
  providerMessageId String?
  errorMessage      String?
  attempts          Int                 @default(0)
  sentAt            DateTime?
  deliveredAt       DateTime?
  nextRetryAt       DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([status, nextRetryAt])
  @@index([notificationId])
  @@map("notification_deliveries")
}

/// Per-user, per-event channel opt-outs. Absence of a row means "use the
/// association default".
model NotificationPreference {
  id        String              @id @default(cuid())
  userId    String
  eventType String
  channel   NotificationChannel
  enabled   Boolean             @default(true)
  updatedAt DateTime            @updatedAt

  @@unique([userId, eventType, channel])
  @@map("notification_preferences")
}

// ============================================================================
// DOCUMENTS, SETTINGS, AUDIT & JOBS
// ============================================================================

model Document {
  id            String      @id @default(cuid())
  associationId String
  association   Association @relation(fields: [associationId], references: [id], onDelete: Cascade)

  memberId      String?
  member        Member?          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  applicationId String?
  application   LoanApplication? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  loanId        String?
  loan          Loan?            @relation(fields: [loanId], references: [id], onDelete: Cascade)

  type       DocumentType
  title      String
  /// Storage key, not a public URL — access is brokered by an authorised
  /// route handler so documents are never directly fetchable.
  storageKey String
  mimeType   String
  sizeBytes  Int
  checksum   String?

  uploadedById    String?
  uploadedBy      User?     @relation("DocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  verifiedById    String?
  verifiedBy      User?     @relation("DocumentVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedAt      DateTime?
  rejectionReason String?

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([associationId, type])
  @@index([memberId])
  @@index([applicationId])
  @@index([loanId])
  @@map("documents")
}

/// Key/value configuration. Scope PLATFORM rows have associationId = null;
/// ASSOCIATION rows override them for one tenant. Business rules live here
/// rather than in code.
model SystemSetting {
  id            String       @id @default(cuid())
  scope         SettingScope @default(PLATFORM)
  associationId String?
  association   Association? @relation(fields: [associationId], references: [id], onDelete: Cascade)

  /// Denormalised uniqueness key: "PLATFORM::<key>" or "ASSOCIATION:<id>:<key>".
  ///
  /// A plain @@unique([scope, associationId, key]) does NOT work here, because
  /// Postgres treats NULLs as distinct in a unique index — two PLATFORM rows
  /// with associationId = null and the same key would both be accepted, and
  /// the application would then read whichever one it happened to find first.
  /// Collapsing the null into a literal makes the constraint real.
  scopeKey String @unique

  key         String
  value       String
  valueType   SettingValueType @default(STRING)
  category    String           @default("general")
  label       String?
  description String?

  /// Encrypted at rest and never returned to any client. Used for provider
  /// credentials that must be editable without a redeploy.
  isSecret   Boolean @default(false)
  /// Whether an association admin may change it, or only a super admin.
  isEditable Boolean @default(true)

  updatedById String?
  updatedBy   User?    @relation("SettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([scope, associationId, key])
  @@index([category])
  @@map("system_settings")
}

/// Immutable record of every consequential action. Financial records are
/// never silently changed — if a balance moved, there is a row here naming
/// who moved it, when, from what, to what.
model AuditLog {
  id            String       @id @default(cuid())
  associationId String?
  association   Association? @relation(fields: [associationId], references: [id], onDelete: SetNull)

  actorId    String?
  actor      User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)
  /// Denormalised so the trail survives even if the user record is removed.
  actorRole  UserRole?
  actorEmail String?

  /// Verb constant, e.g. "ADMIN_APPROVED_LOAN", "BALANCE_ADJUSTED".
  action     String
  entityType String
  entityId   String?

  oldValue Json?
  newValue Json?
  /// Human-readable justification, mandatory for financial adjustments.
  reason   String?
  metadata Json?

  severity  AuditSeverity @default(INFO)
  ipAddress String?
  userAgent String?
  requestId String?

  createdAt DateTime @default(now())

  @@index([associationId, createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
  @@index([severity, createdAt])
  @@map("audit_logs")
}

/// Execution history for background jobs, so a failed reconciliation run is
/// visible in the super-admin dashboard rather than silently lost.
model JobRun {
  id         String    @id @default(cuid())
  jobName    String
  status     JobStatus @default(RUNNING)
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  durationMs Int?

  itemsProcessed Int @default(0)
  itemsSucceeded Int @default(0)
  itemsFailed    Int @default(0)

  /// Cursor/watermark so the next run resumes where this one stopped.
  cursor       String?
  errorMessage String?
  details      Json?

  @@index([jobName, startedAt])
  @@index([status])
  @@map("job_runs")
}

// ============================================================================
// THE RULEBOOK — WRITTEN POLICY THE SOFTWARE ACTUALLY ENFORCES
// ----------------------------------------------------------------------------
// A savings association runs on rules its members agreed to: save this much
// every day, this is the service fee, miss this many days and you are fined,
// borrow no more than this against your own savings, repay over this many
// months at this rate. Until now those rules lived in a constitution document,
// a WhatsApp group and the treasurer's memory, while the software enforced
// constants buried in code that no member could read and no committee could
// change.
//
// These tables close that gap. ONE ROW PER RULE, holding both the human
// sentence a member reads and the machine value the services apply, so there
// is exactly one place a rule can be changed and no way for the printed policy
// and the enforced policy to drift apart.
//
// THREE PROPERTIES THIS SECTION IS BUILT FOR:
//
//  1. LEGIBLE. Every rule carries its own explanation in both languages. A
//     member opening the rules page reads sentences, not a settings table.
//
//  2. AMENDABLE, WITH A RECORD. Rules change when a general meeting resolves
//     to change them. Each edit writes an AssociationRuleRevision, so "who
//     raised the fine to 10%, when, and why" is answerable years later.
//
//  3. SEPARATED. The platform's service fee, the members' savings, the
//     association's share of loan interest and the members' share of it are
//     four different pots of money with four different owners. They get their
//     own tables rather than one column with a `type` on it, because the
//     failure being designed out is an association spending a fee it was only
//     ever collecting on somebody else's behalf.
// ============================================================================

/// What area of association life a rule governs. Drives the grouping on both
/// the admin rulebook and the member-facing rules page.
enum RuleCategory {
  CONTRIBUTIONS
  PLATFORM_FEE
  PENALTIES
  LENDING_ELIGIBILITY
  LOAN_TERMS
  INTEREST_SHARING
  /// Buying goods out of the store and paying for them over months. Its own
  /// category rather than a corner of LOAN_TERMS because the terms genuinely
  /// differ — flat interest, a fixed three months, and none of it shared back
  /// to the borrower.
  WAREHOUSE_CREDIT
  GOVERNANCE
  OTHER
}

/// How a rule's value should be read and edited. MONEY and PERCENT are stored
/// as exact decimal strings for the same reason every other amount is; DAYS,
/// MONTHS and COUNT are integers; TEXT rules carry no value at all and are
/// pure written policy.
enum RuleValueType {
  MONEY
  PERCENT
  DAYS
  MONTHS
  COUNT
  BOOLEAN
  TEXT
}

/// Whether the software applies a rule by itself, proposes it for a person to
/// confirm, or merely publishes it.
///
/// Displayed on every rule, because a member is entitled to know which rules
/// the system acts on without anyone deciding — a fine that appears overnight
/// is a different thing from one an officer chose to raise.
enum RuleEnforcement {
  /// The system applies it: fees charged, fines assessed, limits refused.
  AUTOMATIC
  /// The system detects the condition and asks a person to act.
  ASSISTED
  /// Written policy. Nothing in the code reads it.
  INFORMATIONAL
}

/// ONE RULE. System rules are seeded from lib/rules/catalogue.ts and are keyed
/// so services can look them up; custom rules are written by a committee and
/// carry text only.
///
/// `value` is a string for every type, including money and percentages, for
/// the reason set out at the top of lib/money.ts: a numeric column read back
/// through a JavaScript float is a rounding error waiting to reach a balance.
/// Services parse it with `toMoney` at the point of use.
model AssociationRule {
  id            String      @id @default(cuid())
  associationId String
  association   Association @relation(fields: [associationId], references: [id], onDelete: Cascade)

  /// Stable lookup key, e.g. "contribution.daily_savings". System rules use a
  /// key from the catalogue; custom rules get "custom.<slug>". Unique per
  /// association, so a service asking for a rule can never get two answers.
  key String

  category    RuleCategory
  valueType   RuleValueType
  enforcement RuleEnforcement @default(INFORMATIONAL)

  /// Null for TEXT rules, which are policy prose with nothing to compute.
  value String?

  /// True for rules the code reads. They can be retuned and reworded but never
  /// deleted — removing one would leave a service with no policy to apply.
  isSystem Boolean @default(false)

  /// A deactivated rule stops being enforced and is shown struck through
  /// rather than vanishing, so a member fined under it can still find the rule
  /// they were fined under.
  isActive Boolean @default(true)

  displayOrder Int @default(0)

  /// The rule as members read it, in both languages. Held here rather than in
  /// the dictionary because a committee must be able to reword its own policy
  /// without a deployment.
  titleEn String
  titleRw String
  bodyEn  String @db.Text
  bodyRw  String @db.Text

  /// When this version of the rule began to apply. A fine is judged against
  /// the rule in force on the day it was assessed, not today's wording.
  effectiveFrom DateTime @default(now())
  version       Int      @default(1)

  createdById String?
  createdBy   User?   @relation("RuleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   User?   @relation("RuleUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  revisions AssociationRuleRevision[]

  @@unique([associationId, key])
  @@index([associationId, category, displayOrder])
  @@index([associationId, isActive])
  @@map("association_rules")
}

/// The prior wording and value of a rule, written on every amendment.
/// Append-only: this is the evidence that the policy a member was held to is
/// the policy that was in force at the time.
model AssociationRuleRevision {
  id     String          @id @default(cuid())
  ruleId String
  rule   AssociationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  version  Int
  value    String?
  titleEn  String
  titleRw  String
  bodyEn   String  @db.Text
  bodyRw   String  @db.Text
  isActive Boolean @default(true)

  /// Null when the platform seeded it rather than a person editing it.
  changedById  String?
  changedBy    User?   @relation("RuleRevisionChangedBy", fields: [changedById], references: [id], onDelete: SetNull)
  changeReason String?

  createdAt DateTime @default(now())

  @@unique([ruleId, version])
  @@index([ruleId, createdAt])
  @@map("association_rule_revisions")
}

// ---------------------------------------------------------------------------
// CONTRIBUTION DISCIPLINE
// ---------------------------------------------------------------------------

enum ContributionFineStatus {
  /// Assessed and owed. Visible to the member from the moment it exists.
  OUTSTANDING
  /// Taken out of the member's savings, or paid separately.
  SETTLED
  WAIVED
  /// Assessed in error and withdrawn. Kept, never deleted.
  CANCELLED
}

/// A penalty for falling behind on the daily contribution.
///
/// IDENTIFIED BY `dueDayIndex` — the member's obligation day on which the fine
/// was triggered — rather than by a date. The job that assesses fines runs
/// every night and must be able to run twice without fining twice, and a
/// member who pays part of what they owe must not have the same arrears fined
/// again. Both fall out of a unique constraint on (memberId, dueDayIndex).
model ContributionFine {
  id            String      @id @default(cuid())
  associationId String
  association   Association @relation(fields: [associationId], references: [id], onDelete: Restrict)
  memberId      String
  member        Member      @relation(fields: [memberId], references: [id], onDelete: Restrict)

  reference String @unique

  /// How far behind the member was when this was assessed, and which
  /// obligation day that was. Both are recorded so the member can be shown the
  /// arithmetic rather than a bare figure.
  missedDays  Int
  dueDayIndex Int

  /// The unpaid contribution the percentage was applied to, and the rate in
  /// force on the day. Stored rather than recomputed: the rule may change, and
  /// a fine must remain explainable under the rule that produced it.
  arrearsAmount Decimal @db.Decimal(18, 2)
  rate          Decimal @db.Decimal(9, 4)
  amount        Decimal @db.Decimal(18, 2)
  currency      String  @default("RWF")

  status ContributionFineStatus @default(OUTSTANDING)

  assessedAt   DateTime @default(now())
  /// Null when the nightly job assessed it, set when an officer did.
  assessedById String?
  assessedBy   User?    @relation("FineAssessedBy", fields: [assessedById], references: [id], onDelete: SetNull)

  settledAt            DateTime?
  /// The PENALTY debit that took it out of savings, when that is how it was
  /// settled. Unique: one fine can never be collected twice.
  savingsTransactionId String?             @unique
  savingsTransaction   SavingsTransaction? @relation(fields: [savingsTransactionId], references: [id], onDelete: SetNull)

  waivedAt     DateTime?
  waivedById   String?
  waivedBy     User?     @relation("FineWaivedBy", fields: [waivedById], references: [id], onDelete: SetNull)
  waiverReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([memberId, dueDayIndex])
  @@index([associationId, status, assessedAt])
  @@index([memberId, assessedAt])
  @@map("contribution_fines")
}

/// Per-member settings and reminder bookkeeping for the daily obligation.
///
/// DELIBERATELY HOLDS ALMOST NOTHING. Days owed, days covered and arrears are
/// all derived from the savings ledger on every read — see rule 3 at the top
/// of this schema. What cannot be derived lives here: when this member's
/// obligation started, whether they are excused from it, and which reminder
/// they were last sent, so the worker does not message the same person nightly.
model MemberContributionStanding {
  id            String      @id @default(cuid())
  associationId String
  association   Association @relation(fields: [associationId], references: [id], onDelete: Cascade)
  memberId      String      @unique
  member        Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)

  /// When the daily obligation began. Null falls back to the member's approval
  /// date — but an association admitting an existing saver, or granting
  /// someone a settling-in period, needs to be able to say otherwise.
  obligationStartDate DateTime?

  /// Excused from contributing — illness, maternity, an agreed break. No fees
  /// and no fines accrue while it holds.
  isExempt     Boolean   @default(false)
  exemptReason String?
  exemptUntil  DateTime?

  /// Which warning the member last received, so escalation moves forward
  /// rather than repeating. 0 = none outstanding.
  lastReminderStage Int       @default(0)
  lastReminderAt    DateTime?

  lastEvaluatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([associationId, isExempt])
  @@map("member_contribution_standings")
}

// ---------------------------------------------------------------------------
// THE SEPARATE POTS: the platform's fee, and the two halves of loan interest
// ---------------------------------------------------------------------------

enum PlatformFeeStatus {
  CHARGED
  WAIVED
  REVERSED
}

/// THE PLATFORM'S SERVICE FEE — MONEY THAT IS NOT THE ASSOCIATION'S.
///
/// The daily contribution is 1,000 of savings plus 50 of service fee. Those 50
/// belong to whoever operates this platform; the association merely collects
/// them. Recording the fee in its own table, rather than as one more credit in
/// the association's income, is what stops a committee distributing money it
/// never owned — and what lets the admin screens show the two apart, which is
/// the first thing a member will ask to see.
///
/// `coveredThroughDay` is the member's cumulative contribution-day count that
/// this charge takes the fee up to. Unique per member, so the charging job is
/// idempotent however often it runs.
model PlatformFeeCharge {
  id            String      @id @default(cuid())
  associationId String
  association   Association @relation(fields: [associationId], references: [id], onDelete: Restrict)
  memberId      String
  member        Member      @relation(fields: [memberId], references: [id], onDelete: Restrict)

  reference String @unique

  daysCovered       Int
  coveredThroughDay Int
  feePerDay         Decimal @db.Decimal(18, 2)
  amount            Decimal @db.Decimal(18, 2)
  currency          String  @default("RWF")

  status PlatformFeeStatus @default(CHARGED)

  /// The FEE debit on the member's savings ledger. Their statement then shows
  /// the whole story: 1,050 in, 50 out as the service fee, 1,000 saved.
  savingsTransactionId String?             @unique
  savingsTransaction   SavingsTransaction? @relation(fields: [savingsTransactionId], references: [id], onDelete: SetNull)

  chargedAt   DateTime @default(now())
  chargedById String?
  chargedBy   User?    @relation("PlatformFeeChargedBy", fields: [chargedById], references: [id], onDelete: SetNull)

  /// When the association actually paid this over to the platform operator.
  /// Null means collected but not yet remitted — a liability, and the figure
  /// the admin funds screen shows as owed.
  remittedAt DateTime?

  waiverReason String?

  createdAt DateTime @default(now())

  @@unique([memberId, coveredThroughDay])
  @@index([associationId, chargedAt])
  @@index([associationId, status, remittedAt])
  @@index([memberId, chargedAt])
  @@map("platform_fee_charges")
}

/// HOW ONE REPAYMENT'S INTEREST WAS DIVIDED.
///
/// The lending rule is 2% a month, of which half goes back into the borrower's
/// own savings and half is kept by the association. That split is a promise to
/// the member, so it gets a row of its own rather than being inferred later
/// from two unrelated ledger entries: this is the record proving the member's
/// half was actually credited, and it is what the admin funds screen adds up
/// to show the association's true lending income.
model InterestDistribution {
  id            String      @id @default(cuid())
  associationId String
  association   Association @relation(fields: [associationId], references: [id], onDelete: Restrict)
  loanId        String
  loan          Loan        @relation(fields: [loanId], references: [id], onDelete: Restrict)
  memberId      String
  member        Member      @relation(fields: [memberId], references: [id], onDelete: Restrict)

  /// The repayment whose interest this divides. Unique: a repayment is split
  /// exactly once.
  loanTransactionId String          @unique
  loanTransaction   LoanTransaction @relation(fields: [loanTransactionId], references: [id], onDelete: Restrict)

  interestCollected Decimal @db.Decimal(18, 2)
  memberShare       Decimal @db.Decimal(18, 2)
  associationShare  Decimal @db.Decimal(18, 2)
  currency          String  @default("RWF")

  /// The two halves of the monthly rate as they stood when this was posted, so
  /// an old distribution stays explainable after the rule changes.
  memberRate      Decimal @db.Decimal(9, 4)
  associationRate Decimal @db.Decimal(9, 4)

  /// The INTEREST credit on the borrower's savings. Null only when the member
  /// share was zero, or their account was closed and an officer must post it.
  savingsTransactionId String?             @unique
  savingsTransaction   SavingsTransaction? @relation(fields: [savingsTransactionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([associationId, createdAt])
  @@index([memberId, createdAt])
  @@index([loanId, createdAt])
  @@map("interest_distributions")
}

// ============================================================================
// BANK OF KIGALI OPENAPI INTEGRATION
// ============================================================================

/// Lifecycle of a BK transaction reconciliation status.
enum BkReconciliationStatus {
  UNMATCHED
  MATCHED
  MANUALLY_MATCHED
  DUPLICATE
  PENDING
  FAILED
  COMPLETED
  REJECTED
}

/// How a BK transaction was matched to a member.
enum BkMatchStrategy {
  MEMBER_PAYMENT_REFERENCE
  EXTERNAL_REFERENCE
  PAYMENT_CODE
  PHONE_NUMBER
  BANK_ACCOUNT
  PAYER_NAME
  MANUAL
  NONE
}

/// A transaction record retrieved from the Bank of Kigali OpenAPI.
///
/// Captured verbatim BEFORE any interpretation, mirroring the discipline
/// applied to the Jenga Payment model. BK transactions are reconciled
/// separately from Jenga payments because they come through a different
/// channel and carry different identifying information.
model BkTransaction {
  id  String @id @default(cuid())
  /// Nullable: a transaction not yet associated with an association.
  associationId String?
  association   Association? @relation(fields: [associationId], references: [id], onDelete: Restrict)

  /// Primary duplicate guard: the BK extras.id field
  bkTransactionId String  @unique(map: "bk_transactions_bk_transaction_id_key")
  /// BK clientReference, if present
  bkClientReference String?
  /// BK transactionReference
  bkTransactionReference String?
  /// BK extras.paymentCode
  bkPaymentCode String?
  /// BK extras.clientReference
  bkExtrasClientReference String?

  /// Amount received
  amount Decimal @db.Decimal(18, 2)
  currency String  @default("RWF")

  /// BK transaction status (e.g., PENDING, SUCCESS)
  bkStatus String?
  /// BK extras.status
  bkExtrasStatus String?

  /// Payer information from BK extras
  payerNames  String?
  payerAccount String?
  payerContact String?

  /// Payee information
  payeeNames  String?
  payeeAccount String?
  beneficiaryNames  String?
  beneficiaryBank  String?
  beneficiaryBankCode String?

  /// Transaction details
  narration     String?
  serviceCode   String?
  transferType  String?
  sourceChannel String?

  /// BK transaction stage and status comment
  transactionStage       String?
  transactionStatus      String?
  transactionStatusComment String?

  /// Digital profile ID
  digitalProfileId String?

  /// Debited/credited accounts (masked in BK response)
  debitedAccount         String?
  debitedAccountOwnerNames String?
  creditedAccount         String?
  creditedAccountOwnerNames String?
  debitCurrency String?
  creditCurrency String?

  /// Debit account from BK
  debitAccount  String?
  creditAccount String?

  /// Timestamps from BK
  transactionDate DateTime?
  createdDate    DateTime?
  updatedDate    DateTime?

  /// Raw BK response stored for audit/debugging
  rawPayload Json?

  /// Reconciliation status
  reconciliationStatus BkReconciliationStatus @default(UNMATCHED)

  /// Matched member
  matchedMemberId String?
  matchedMember   Member? @relation(fields: [matchedMemberId], references: [id], onDelete: SetNull)

  /// How the transaction was matched
  matchStrategy BkMatchStrategy @default(NONE)
  /// 0-100 confidence score
  matchConfidence Int @default(0)

  /// Manual match details
  matchedById String?
  matchedBy   User?  @relation("BkTransactionMatchedBy", fields: [matchedById], references: [id], onDelete: SetNull)
  matchedAt   DateTime?
  matchReason String?

  /// RTA Payment link (when reconciled to the ledger)
  paymentId         String? @unique
  payment           Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  /// Import tracking
  importedAt   DateTime @default(now())
  lastSyncedAt DateTime @default(now())

  /// Error information if sync failed
  syncError     String?
  syncErrorCode String?

  /// Reversal tracking
  isReversal Boolean @default(false)
  reversedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reconciliations BkTransactionReconciliation[]

  @@index([associationId, reconciliationStatus])
  @@index([reconciliationStatus, transactionDate])
  @@index([matchedMemberId])
  @@index([payerContact])
  @@index([bkPaymentCode])
  @@index([bkClientReference])
  @@index([lastSyncedAt])
  @@index([importedAt])
  @@map("bk_transactions")
}

/// Reconciliation audit trail for BK transactions.
model BkTransactionReconciliation {
  id            String  @id @default(cuid())
  bkTransactionId String
  bkTransaction BkTransaction @relation(fields: [bkTransactionId], references: [id], onDelete: Cascade)

  attempt    Int   @default(1)
  outcome    BkReconciliationStatus
  strategy   BkMatchStrategy @default(NONE)
  confidence Int   @default(0)

  /// Candidate members considered for matching
  candidateIds     String[]
  resolvedMemberId String?

  notes        String?
  errorMessage String?

  performedById String?
  performedBy   User?   @relation("BkReconciliationPerformedBy", fields: [performedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([bkTransactionId, attempt])
  @@map("bk_transaction_reconciliations")
}

/// A payment claim this system registered with BK.
///
/// Claiming is the half of the loop RTA initiates: it declares an intent to
/// collect, and BK answers CLAIMED. The transaction sync is the other half.
/// Holding the claim lets the association answer the only question that
/// matters when testing the integration — did the money we asked for actually
/// come back through getTransactions, and how long did it take?
model BkPaymentClaim {
  id            String      @id @default(cuid())
  associationId String
  association   Association @relation(fields: [associationId], references: [id], onDelete: Cascade)

  /// Our own reference, sent to BK and echoed back on the transaction.
  clientReference String @unique
  /// The payer's six-digit code from Internet Banking or the BK app.
  payerCode String
  narration String
  amount    Decimal @db.Decimal(18, 2)
  currency  String  @default("RWF")

  /// Which member this claim was raised for, when known.
  memberId String?
  member   Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  /// BK's answer: CLAIMED, or an error we recorded instead.
  status      String
  expiryTime  DateTime?
  failed      Boolean   @default(false)
  errorMessage String?
  rawResponse Json?

  /// Set when the transaction sync first returns a transaction carrying this
  /// clientReference. Null means BK has not surfaced it yet.
  observedAt         DateTime?
  observedTransactionId String?

  createdById String?
  createdBy   User?   @relation("BkClaimCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([associationId, createdAt])
  @@index([associationId, observedAt])
  @@index([payerCode])
  @@map("bk_payment_claims")
}

/// Sync history for BK transactions.
model BkSyncLog {
  id         String    @id @default(cuid())
  status     JobStatus @default(RUNNING)
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  durationMs Int?

  /// Sync configuration
  lookbackHours Int?
  pageSize     Int?
  startPage    Int?
  endPage     Int?

  /// Results
  transactionsFetched Int @default(0)
  transactionsCreated Int @default(0)
  transactionsUpdated Int @default(0)
  duplicatesSkipped  Int @default(0)
  matchedCount       Int @default(0)
  unmatchedCount     Int @default(0)
  errorsCount        Int @default(0)

  /// Pagination cursor
  nextPage   Int?
  hasMore    Boolean @default(false)

  errorMessage String?
  errorDetails Json?

  triggeredById String?
  triggeredBy  User?  @relation("BkSyncTriggeredBy", fields: [triggeredById], references: [id], onDelete: SetNull)

  @@index([status, startedAt])
  @@index([startedAt])
  @@map("bk_sync_logs")
}

// ============================================================================
// THE WAREHOUSE
// ----------------------------------------------------------------------------
// The association buys fabric, thread, machines and tools in bulk and hands
// them to members — sometimes sold on credit, sometimes lent out for a season,
// sometimes pledged against a loan. That is real money leaving the association
// in a form that is not cash, and before this section existed it left no trace
// a member could be shown.
//
// The design follows the savings ledger deliberately, because the failure mode
// is identical. Quantities on hand are a CACHE over an append-only movement
// log: every movement records quantityBefore/quantityAfter and a per-item
// monotonic `sequence`, so stock can always be rebuilt from history and a
// disagreement between the count and the log is detectable rather than silent.
// See rules 2 and 3 at the top of this file.
//
// Quantities are Decimal(18,3), not integers: fabric is issued in metres and
// thread by weight, and rounding 2.5 metres to "3 pieces" would put a value on
// a member's file that they never received.
// ============================================================================

/// What a movement did to the stock on hand.
///
/// ADJUSTMENT is the only type that may move in either direction, and it is
/// one of the two that require a written reason — a stock count that silently
/// corrects itself is how shrinkage disappears.
enum WarehouseMovementType {
  /// Bought in, donated, or transferred in. Increases stock.
  RECEIPT
  /// Handed to a member. Decreases stock.
  ISSUE
  /// Came back from a member. Increases stock.
  RETURN
  /// A physical count correcting the book figure. Either direction.
  ADJUSTMENT
  /// Damaged, lost, expired or stolen. Decreases stock, and the value is a
  /// loss the association bears rather than a debt any member owes.
  WRITE_OFF
}

/// IN increases quantity on hand, OUT decreases it. Stored explicitly rather
/// than inferred from `type` so an adjustment can move either way without the
/// reader having to know which types are which.
enum WarehouseStockDirection {
  IN
  OUT
}

enum WarehouseItemCategory {
  FABRIC
  THREAD_AND_TRIM
  MACHINE
  MACHINE_PART
  TOOL
  PACKAGING
  CONSUMABLE
  FINISHED_GOODS
  OTHER
}

/// On what footing a member took the goods. This decides whether they owe
/// money, owe the goods back, or owe nothing at all — so it is a column and
/// not a note.
enum WarehouseIssueTerms {
  /// Theirs to keep. The value is a debt until settled.
  PURCHASE
  /// Theirs to keep, paid for over months with interest. Opens a
  /// WarehouseCredit, which is what the member then owes against — see the
  /// WAREHOUSE CREDIT section below.
  CREDIT
  /// Lent out and expected back — a machine for a season, a tool for a job.
  LOAN_OUT
  /// Issued as part of a loan, and the value counts toward that loan's
  /// collateral. Settled through the loan, not separately.
  AGAINST_LOAN
  /// A grant, a prize, or training material. No charge and no return.
  FREE_ISSUE
}

/// Where one issuance stands. PARTIALLY_RETURNED exists because a member who
/// brings back three of five machines has done something the record must be
/// able to say, rather than rounding to "returned" or "still out".
enum WarehouseIssuanceStatus {
  ISSUED
  PARTIALLY_RETURNED
  RETURNED
  /// The member keeps the goods and the value is owed.
  CHARGED
  /// Charged and paid for, in cash or out of savings.
  SETTLED
  /// Never coming back and never being paid for. Written off to loss.
  WRITTEN_OFF
  /// Recorded in error and withdrawn. Kept, never deleted.
  CANCELLED
}

/// ONE STOCK LINE. The catalogue entry, plus the cached position.
model WarehouseItem {
  id            String      @id @default(cuid())
  associationId String
  association   Association @relation(fields: [associationId], references: [id], onDelete: Restrict)

  /// Stock code as the storekeeper writes it, unique inside the association.
  sku      String
  name     String
  /// The name members actually use for it. Falls back to `name` when unset,
  /// so a Kinyarwanda screen never shows an English-only label it had a
  /// translation for.
  nameRw   String?
  category WarehouseItemCategory @default(OTHER)

  /// The unit stock is counted in — "metre", "piece", "roll", "kg". Free text
  /// because a fixed enum cannot anticipate what an association stocks.
  unit String @default("piece")

  /// What it cost the association, and what a member is charged. Kept apart:
  /// selling at cost is a policy an association may choose, and it must be
  /// visible as a choice rather than baked in.
  unitCost  Decimal @db.Decimal(18, 2)
  unitPrice Decimal @db.Decimal(18, 2)
  currency  String  @default("RWF")

  /// CACHED position. Only ever written inside the same DB transaction that
  /// appends a WarehouseStockMovement, with this row locked FOR UPDATE.
  /// Must always equal the quantityAfter of the highest-sequence movement.
  quantityOnHand Decimal @default(0) @db.Decimal(18, 3)
  /// Out with members right now on returnable terms. Maintained alongside the
  /// open issuance lines; never a source of truth.
  quantityIssued Decimal @default(0) @db.Decimal(18, 3)

  /// Below this, the item shows as needing a reorder. Zero disables it.
  reorderLevel Decimal @default(0) @db.Decimal(18, 3)

  /// Monotonic per-item counter. The next movement takes lastSequence + 1,
  /// which makes gaps and replays detectable.
  lastSequence Int @default(0)

  isActive Boolean @default(true)
  notes    String?

  createdById String?
  createdBy   User?   @relation("WarehouseItemCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movements     WarehouseStockMovement[]
  issuanceLines WarehouseIssuanceLine[]

  @@unique([associationId, sku])
  @@index([associationId, isActive])
  @@index([associationId, category])
  @@map("warehouse_items")
}

/// THE STOCK LEDGER. Append-only: rows are never updated and never deleted.
/// A mistake is corrected by posting an ADJUSTMENT carrying its reason,
/// exactly as a savings error is corrected by a reversal.
model WarehouseStockMovement {
  id            String        @id @default(cuid())
  associationId String
  association   Association   @relation(fields: [associationId], references: [id], onDelete: Restrict)
  itemId        String
  item          WarehouseItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  /// Position in this item's ledger. Unique per item — the database itself
  /// rejects two concurrent writers claiming the same slot.
  sequence Int

  /// Storekeeper-facing movement id, e.g. "WHM-2609-0001234".
  reference String @unique

  type      WarehouseMovementType
  direction WarehouseStockDirection

  /// Always positive. Direction carries the sign.
  quantity       Decimal @db.Decimal(18, 3)
  quantityBefore Decimal @db.Decimal(18, 3)
  quantityAfter  Decimal @db.Decimal(18, 3)

  /// The unit value in force when this moved, and the line total. Stored
  /// rather than recomputed from the item: prices change, and a movement must
  /// stay explainable at the value it was recorded at.
  unitValue  Decimal @db.Decimal(18, 2)
  totalValue Decimal @db.Decimal(18, 2)
  currency   String  @default("RWF")

  /// Source linkage — every stock row is traceable back to what caused it.
  issuanceId     String?
  issuance       WarehouseIssuance?     @relation(fields: [issuanceId], references: [id], onDelete: SetNull)
  issuanceLineId String?
  issuanceLine   WarehouseIssuanceLine? @relation(fields: [issuanceLineId], references: [id], onDelete: SetNull)

  supplierName    String?
  deliveryNoteRef String?
  note            String?
  /// Mandatory for ADJUSTMENT and WRITE_OFF — enforced in the service layer,
  /// which refuses to post either without one.
  reason          String?

  /// Null when posted by the system rather than by a person.
  recordedById String?
  recordedBy   User?   @relation("WarehouseMovementRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@unique([itemId, sequence])
  @@index([associationId, occurredAt])
  @@index([associationId, type, occurredAt])
  @@index([itemId, occurredAt])
  @@index([issuanceId])
  @@map("warehouse_stock_movements")
}

/// WHAT ONE MEMBER TOOK, on one occasion.
///
/// The header carries the terms and the money; the lines carry the goods. A
/// member's warehouse position on their account page is the sum of these, and
/// it is the reason this model exists at all.
model WarehouseIssuance {
  id            String      @id @default(cuid())
  associationId String
  association   Association @relation(fields: [associationId], references: [id], onDelete: Restrict)
  memberId      String
  member        Member      @relation(fields: [memberId], references: [id], onDelete: Restrict)

  /// Member-facing issue id, e.g. "WHI-2609-0001234".
  reference String @unique

  terms  WarehouseIssueTerms     @default(PURCHASE)
  status WarehouseIssuanceStatus @default(ISSUED)

  /// Set when the goods form part of a loan's collateral, so a member can
  /// follow the machine on their file back to the loan it secures.
  loanId String?
  loan   Loan?   @relation(fields: [loanId], references: [id], onDelete: SetNull)

  /// The value of the goods as issued, the part already paid for, and the
  /// value handed back. `amountSettled + amountReturned` never exceeds
  /// `totalValue`; the service checks before writing either.
  totalValue     Decimal @db.Decimal(18, 2)
  amountSettled  Decimal @default(0) @db.Decimal(18, 2)
  amountReturned Decimal @default(0) @db.Decimal(18, 2)
  currency       String  @default("RWF")

  issuedAt DateTime @default(now())
  /// When a LOAN_OUT is expected back. Null on terms that expect no return.
  dueBackAt    DateTime?
  returnedAt   DateTime?
  settledAt    DateTime?
  writtenOffAt DateTime?

  /// The FEE debit that took the value out of the member's savings, when that
  /// is how it was settled. Unique: one issuance is never collected twice.
  savingsTransactionId String?             @unique
  savingsTransaction   SavingsTransaction? @relation(fields: [savingsTransactionId], references: [id], onDelete: SetNull)

  note           String?
  cancelReason   String?
  writeOffReason String?

  issuedById String?
  issuedBy   User?   @relation("WarehouseIssuedBy", fields: [issuedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines     WarehouseIssuanceLine[]
  movements WarehouseStockMovement[]

  /// Set only on CREDIT terms: the instalment arrangement this issue opened.
  credit WarehouseCredit?

  @@index([associationId, status, issuedAt])
  @@index([memberId, issuedAt])
  @@index([loanId])
  @@map("warehouse_issuances")
}

/// One item on one issuance.
model WarehouseIssuanceLine {
  id         String            @id @default(cuid())
  issuanceId String
  issuance   WarehouseIssuance @relation(fields: [issuanceId], references: [id], onDelete: Cascade)
  itemId     String
  item       WarehouseItem     @relation(fields: [itemId], references: [id], onDelete: Restrict)

  /// Denormalised at issue time so a renamed catalogue entry cannot rewrite
  /// what a member was told they received.
  itemName String
  unit     String

  quantity         Decimal @db.Decimal(18, 3)
  quantityReturned Decimal @default(0) @db.Decimal(18, 3)

  unitValue Decimal @db.Decimal(18, 2)
  lineValue Decimal @db.Decimal(18, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movements WarehouseStockMovement[]

  @@index([issuanceId])
  @@index([itemId])
  @@map("warehouse_issuance_lines")
}

// ============================================================================
// WAREHOUSE CREDIT — GOODS BOUGHT NOW AND PAID FOR OVER THREE MONTHS
// ============================================================================
//
// A member who takes a sewing machine on PURCHASE terms owes its value the
// moment it leaves the store, in full, whenever an officer asks for it. That
// suits a roll of fabric and is hopeless for a machine: the member cannot pay
// today, the association wants the machine working, and what actually happens
// is an arrangement made verbally and remembered inconsistently.
//
// THIS SECTION MAKES THAT ARRANGEMENT A RECORD. Goods issued on CREDIT terms
// open exactly one WarehouseCredit, with the association's terms frozen onto
// it: the value of the goods, the interest, the number of months, and the fine
// rate that applies if a month is missed. The member is then shown three dated
// instalments and what each one costs.
//
// WHY THIS IS NOT A `Loan`. Four differences, each of which would otherwise
// have to become a branch inside the cash-lending path:
//
//  1. NOTHING IS DISBURSED. No money left the association; a machine did. The
//     value is already accounted for by the stock movement that issued it, and
//     recording it again as principal lent out would double-count it in every
//     report of where the association's money went.
//
//  2. THE INTEREST IS NOT SHARED. A cash loan's 2% a month is split, half back
//     into the borrower's own savings and half to the association. The
//     interest on warehouse goods is the association's in full — it is what
//     the association earns for carrying the cost of stock a member is using
//     before paying for it. See `interestToAssociation`, which is stored on
//     every row rather than assumed, so the record stays true if that policy
//     is ever revisited.
//
//  3. THE TERM IS FIXED AND SHORT. Three months, not up to six, because the
//     association is financing goods rather than lending savings.
//
//  4. ELIGIBILITY DOES NOT APPLY. The six-month membership rule, the ceiling
//     at 80% of your own savings and the collateral test all exist to protect
//     the members' savings pool from cash going out of it. None of them should
//     stand between a tailor and a reel of thread.
//
// Every figure a member is ever shown here is frozen at the moment it was
// agreed, for the same reason prices are frozen onto stock movements: a rate
// the committee changes in June must not silently rewrite what a member signed
// up to in March.

/// Where one credit arrangement stands.
enum WarehouseCreditStatus {
  /// Running, and not behind.
  ACTIVE
  /// At least one instalment is past its due date and unpaid.
  OVERDUE
  /// Paid off in full — goods value, interest and any fines.
  COMPLETED
  /// The term ran out and it was not paid. Still owed; still collectable.
  DEFAULTED
  /// Given up on. The association bears the loss.
  WRITTEN_OFF
  /// Opened in error and withdrawn. Kept, never deleted.
  CANCELLED
}

/// A fine's life. Mirrors ContributionFineStatus deliberately: a member should
/// meet one idea of what a fine is, not two.
enum WarehouseCreditFineStatus {
  /// Assessed and owed. Visible to the member from the moment it exists.
  OUTSTANDING
  /// Paid, in cash or out of savings.
  SETTLED
  /// Forgiven by an officer, with a written reason.
  WAIVED
  /// Assessed in error and withdrawn. Kept, never deleted.
  CANCELLED
}

/// ONE CREDIT ARRANGEMENT, against exactly one issuance of goods.
model WarehouseCredit {
  id            String      @id @default(cuid())
  associationId String
  association   Association @relation(fields: [associationId], references: [id], onDelete: Restrict)
  memberId      String
  member        Member      @relation(fields: [memberId], references: [id], onDelete: Restrict)

  /// The goods this pays for. One issuance opens at most one credit, which is
  /// what the unique constraint says: a member cannot be made to owe twice for
  /// the same machine.
  issuanceId String            @unique
  issuance   WarehouseIssuance @relation(fields: [issuanceId], references: [id], onDelete: Restrict)

  /// Member-facing credit id, e.g. "WHC-2609-0001234".
  reference String                @unique
  status    WarehouseCreditStatus @default(ACTIVE)

  // --- Terms, frozen at the moment the credit was opened -------------------

  /// What the goods were worth. The principal.
  goodsValue Decimal @db.Decimal(18, 2)
  /// Interest for the WHOLE term, not per month — the association's rule is a
  /// flat 2% on the value of the goods, however early it is paid off.
  interestRate   Decimal @db.Decimal(9, 4)
  interestAmount Decimal @db.Decimal(18, 2)
  /// Charged on the unpaid part of an instalment that passed its due date.
  fineRate       Decimal @db.Decimal(9, 4)
  /// Days after a due date before the fine is assessed. Zero means the fine
  /// falls the day after.
  fineGraceDays  Int     @default(0)
  termMonths     Int
  /// False only if an association ever resolves to share this interest with
  /// the borrower the way cash-loan interest is shared. Stored per row so an
  /// old credit stays explainable under the rule that produced it.
  interestToAssociation Boolean @default(true)

  /// goodsValue + interestAmount. Fines are NOT included: they are not part of
  /// what was agreed, and a member must be able to see the difference between
  /// what they signed up to and what falling behind added.
  totalPayable Decimal @db.Decimal(18, 2)
  currency     String  @default("RWF")

  // --- The live position, split so allocation is exact ---------------------

  principalOutstanding Decimal @default(0) @db.Decimal(18, 2)
  interestOutstanding  Decimal @default(0) @db.Decimal(18, 2)
  penaltyOutstanding   Decimal @default(0) @db.Decimal(18, 2)

  principalPaid Decimal @default(0) @db.Decimal(18, 2)
  interestPaid  Decimal @default(0) @db.Decimal(18, 2)
  penaltyPaid   Decimal @default(0) @db.Decimal(18, 2)
  totalPaid     Decimal @default(0) @db.Decimal(18, 2)

  /// Monotonic per-credit counter for the payment ledger below. The next
  /// payment takes lastSequence + 1, which makes gaps and replays detectable.
  lastSequence Int @default(0)

  startedAt     DateTime  @default(now())
  firstDueDate  DateTime
  maturityDate  DateTime
  lastPaymentAt DateTime?
  completedAt   DateTime?
  defaultedAt   DateTime?
  writtenOffAt  DateTime?
  cancelledAt   DateTime?

  /// How far past due the oldest unpaid instalment is. Refreshed by the
  /// scheduled job; a cache over the instalments, never a source of truth.
  daysOverdue Int @default(0)

  writeOffReason String?
  cancelReason   String?
  note           String?

  openedById String?
  openedBy   User?   @relation("WarehouseCreditOpenedBy", fields: [openedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  installments WarehouseCreditInstallment[]
  payments     WarehouseCreditPayment[]
  fines        WarehouseCreditFine[]

  @@index([associationId, status, startedAt])
  @@index([memberId, startedAt])
  @@index([status, maturityDate])
  @@map("warehouse_credits")
}

/// ONE MONTH'S INSTALMENT. Three of these per credit, generated when it opens.
model WarehouseCreditInstallment {
  id       String          @id @default(cuid())
  creditId String
  credit   WarehouseCredit @relation(fields: [creditId], references: [id], onDelete: Cascade)

  installmentNumber Int
  dueDate           DateTime
  status            InstallmentStatus @default(UPCOMING)

  principalDue Decimal @db.Decimal(18, 2)
  interestDue  Decimal @db.Decimal(18, 2)
  /// Fines assessed against THIS month. Raised by the job, not scheduled.
  penaltyDue   Decimal @default(0) @db.Decimal(18, 2)
  /// principalDue + interestDue. Excludes penalties for the same reason
  /// `totalPayable` does — this is what was agreed for this month.
  totalDue     Decimal @db.Decimal(18, 2)

  principalPaid Decimal @default(0) @db.Decimal(18, 2)
  interestPaid  Decimal @default(0) @db.Decimal(18, 2)
  penaltyPaid   Decimal @default(0) @db.Decimal(18, 2)
  totalPaid     Decimal @default(0) @db.Decimal(18, 2)

  /// Goods value still owed after this instalment, per the original schedule.
  balanceAfter Decimal @db.Decimal(18, 2)

  paidAt      DateTime?
  daysOverdue Int       @default(0)

  waivedAt     DateTime?
  waivedById   String?
  waivedBy     User?     @relation("WarehouseInstallmentWaivedBy", fields: [waivedById], references: [id], onDelete: SetNull)
  waiverReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fine        WarehouseCreditFine?
  allocations WarehouseCreditAllocation[]

  @@unique([creditId, installmentNumber])
  @@index([creditId, dueDate])
  @@index([status, dueDate])
  @@map("warehouse_credit_installments")
}

/// THE CREDIT LEDGER. Append-only, same discipline as SavingsTransaction and
/// LoanTransaction: a payment recorded in error is corrected by a reversing
/// entry, never by editing the row.
model WarehouseCreditPayment {
  id            String          @id @default(cuid())
  associationId String
  association   Association     @relation(fields: [associationId], references: [id], onDelete: Restrict)
  creditId      String
  credit        WarehouseCredit @relation(fields: [creditId], references: [id], onDelete: Restrict)

  /// Position in this credit's ledger. Unique per credit — the database itself
  /// rejects two concurrent writers claiming the same slot.
  sequence Int
  /// Member-facing payment id, e.g. "WCP-2609-0001234".
  reference String @unique

  amount Decimal @db.Decimal(18, 2)

  /// How the payment was split. The three always sum to `amount`, and the
  /// order is fixed by the service: fines first, then interest, then the goods
  /// themselves. Stored rather than recomputed, so a member can be shown the
  /// arithmetic of a payment made a year ago.
  penaltyPortion   Decimal @default(0) @db.Decimal(18, 2)
  interestPortion  Decimal @default(0) @db.Decimal(18, 2)
  principalPortion Decimal @default(0) @db.Decimal(18, 2)

  /// The interest that went to the association on this payment. Equal to
  /// `interestPortion` under the standing rule; stored so the association's
  /// income can be summed from the ledger without re-deriving policy.
  associationIncome Decimal @default(0) @db.Decimal(18, 2)

  balanceAfter Decimal @db.Decimal(18, 2)
  currency     String  @default("RWF")

  /// The FEE debit that took the money out of the member's savings, when that
  /// is how it was paid. Unique: one savings debit is never claimed by two
  /// payments.
  savingsTransactionId String?             @unique
  savingsTransaction   SavingsTransaction? @relation(fields: [savingsTransactionId], references: [id], onDelete: SetNull)

  /// How it reached the association when it did not come out of savings.
  channel PaymentChannel?
  note    String?

  recordedById String?
  recordedBy   User?   @relation("WarehouseCreditPaymentRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  allocations WarehouseCreditAllocation[]

  @@unique([creditId, sequence])
  @@index([associationId, occurredAt])
  @@index([creditId, occurredAt])
  @@map("warehouse_credit_payments")
}

/// Which instalment a payment paid, and how much of it. One payment usually
/// touches one instalment and sometimes spills into the next, so this is a
/// table rather than a column.
model WarehouseCreditAllocation {
  id            String                     @id @default(cuid())
  paymentId     String
  payment       WarehouseCreditPayment     @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  installmentId String
  installment   WarehouseCreditInstallment @relation(fields: [installmentId], references: [id], onDelete: Restrict)

  penaltyAmount   Decimal @default(0) @db.Decimal(18, 2)
  interestAmount  Decimal @default(0) @db.Decimal(18, 2)
  principalAmount Decimal @default(0) @db.Decimal(18, 2)
  totalAmount     Decimal @db.Decimal(18, 2)

  createdAt DateTime @default(now())

  @@unique([paymentId, installmentId])
  @@index([installmentId])
  @@map("warehouse_credit_allocations")
}

/// THE 7% FOR A MISSED MONTH.
///
/// IDENTIFIED BY THE INSTALMENT IT PUNISHES, not by a date. The job that
/// assesses these runs on a schedule and must be able to run twice without
/// fining twice, which is what the unique constraint on `installmentId`
/// guarantees. One missed month, one fine, no matter how many times anything
/// re-runs.
///
/// The rate is applied to what was STILL UNPAID on the instalment when the
/// fine fell — not to the whole credit. A member who paid four fifths of a
/// month and was three days late is fined on the fifth, which is the same
/// principle the daily contribution fine already follows.
model WarehouseCreditFine {
  id            String          @id @default(cuid())
  associationId String
  association   Association     @relation(fields: [associationId], references: [id], onDelete: Restrict)
  creditId      String
  credit        WarehouseCredit @relation(fields: [creditId], references: [id], onDelete: Cascade)
  memberId      String
  member        Member          @relation(fields: [memberId], references: [id], onDelete: Restrict)

  /// One fine per missed instalment. See the note above.
  installmentId String                     @unique
  installment   WarehouseCreditInstallment @relation(fields: [installmentId], references: [id], onDelete: Cascade)

  reference String @unique

  /// The unpaid amount the rate was applied to, the rate in force on the day,
  /// and the result. All three stored, so the member can be shown the sum
  /// rather than a bare figure, and so a later rate change cannot make an old
  /// fine unexplainable.
  arrearsAmount Decimal @db.Decimal(18, 2)
  rate          Decimal @db.Decimal(9, 4)
  amount        Decimal @db.Decimal(18, 2)
  currency      String  @default("RWF")

  /// How late the instalment was when this fell.
  daysLate Int @default(0)

  status WarehouseCreditFineStatus @default(OUTSTANDING)

  assessedAt DateTime @default(now())
  /// Null when the scheduled job assessed it, set when an officer did.
  assessedById String?
  assessedBy   User?   @relation("WarehouseFineAssessedBy", fields: [assessedById], references: [id], onDelete: SetNull)

  settledAt DateTime?

  waivedAt     DateTime?
  waivedById   String?
  waivedBy     User?     @relation("WarehouseFineWaivedBy", fields: [waivedById], references: [id], onDelete: SetNull)
  waiverReason String?

  cancelledAt  DateTime?
  cancelReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([associationId, status, assessedAt])
  @@index([memberId, assessedAt])
  @@index([creditId])
  @@map("warehouse_credit_fines")
}
